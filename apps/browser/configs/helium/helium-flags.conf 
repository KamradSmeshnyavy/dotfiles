# ~/.config/helium-flags.conf

# Wayland и жесты
--ozone-platform=wayland
--ozone-platform-hint=wayland
--enable-features=TouchpadOverscrollHistoryNavigation,WaylandWindowDecorations
--load-extension=~/.local/share/omarchy/default/chromium/extensions/copy-url

# Безопасное и быстрое ускорение через OpenGL/EGL
--use-gl=angle
--use-angle=gl-egl

# Включение аппаратной отрисовки страниц силами Intel Arc
--enable-gpu-rasterization
--enable-oop-rasterization
--enable-zero-copy

# Аппаратное декодирование видео (VA-API)
--enable-features=VaapiVideoDecodeLinuxGL,VaapiVideoEncoder,CanvasOopRasterization,BatterySaverModeAvailable,BatterySaverOnBattery
--ignore-gpu-blocklist

--disable-smooth-scrolling
