# wl-kbptr can be configured with a configuration file.
# The file location can be passed with the -c parameter.
# Othewise the `$XDG_CONFIG_HOME/wl-kbptr/config` file will
# be loaded if it exits. Below is the default configuration.

[general]
home_row_keys=
modes=tile,bisect
cancellation_status_code=0

[mode_tile]
# 28 symbols: the tile grid is ~690 cells on this display (wl-kbptr hardcodes
# max 26*26 but rounds the cell size down, so it overshoots), and 26 symbols
# would force 3-character labels. 28*28 = 784 keeps every label 2 characters.
label_color=#e0def4
label_select_color=#eb6f92
unselectable_bg_color=#191724cc
selectable_bg_color=#26233aee
selectable_border_color=#c4a7e7
label_font_family=sans-serif
label_font_size=24 50% 100
label_symbols=abcdefghijklmnopqrstuvwxyz;,

[mode_floating]
source=stdin
label_color=#9ccfd8
label_select_color=#eb6f92
unselectable_bg_color=#191724bb
selectable_bg_color=#191724ee
selectable_border_color=#9ccfd8
label_font_family=sans-serif
label_font_size=20 50% 100
label_symbols=abcdefghijklmnopqrstuvwxyz

[mode_bisect]
label_color=#e0def4dd
label_font_size=20
label_font_family=sans-serif
label_padding=12
pointer_size=20
pointer_color=#eb6f92dd
unselectable_bg_color=#19172466
even_area_bg_color=#31748f44
even_area_border_color=#31748f88
odd_area_bg_color=#c4a7e744
odd_area_border_color=#c4a7e788
history_border_color=#524f6799

[mode_split]
pointer_size=20
pointer_color=#eb6f92dd
bg_color=#19172466
area_bg_color=#1f1d2e88
vertical_color=#c4a7e7cc
horizontal_color=#9ccfd8cc
history_border_color=#524f6799

[mode_click]
button=left
