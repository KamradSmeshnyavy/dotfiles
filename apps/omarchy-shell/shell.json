{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "id": "kamradsmeshnyavy.bar",
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.workspaces",
    "layout": {
      "left": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.clock",
          "format": "HH:mm",
          "weekStartDay": "monday"
        }
      ],
      "center": [
        {
          "id": "kamradsmeshnyavy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.monitor"
        }
      ],
      "right": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power",
          "showPercentage": false
        },
        {
          "id": "omarchy.tailscale"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "kamradsmeshnyavy.background"
    },
    {
      "id": "kamradsmeshnyavy.customizer"
    },
    {
      "id": "kamradsmeshnyavy.image-picker"
    },
    {
      "id": "kamradsmeshnyavy.lock"
    }
  ],
  "disabledPlugins": [
    "omarchy.background",
    "omarchy.image-picker",
    "omarchy.lock",
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "kamradsmeshnyavy.background",
    "kamradsmeshnyavy.image-picker",
    "kamradsmeshnyavy.lock",
    "kamradsmeshnyavy.menu"
  ]
}
