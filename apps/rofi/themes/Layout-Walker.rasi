/* ---- Load wallust colors ---- */
@theme "/home/kamradsmeshnyavy/dotfiles/apps/rofi/wallust/colors-rofi.rasi"

/* ---- Configuration ---- */
configuration {
    modi: "drun,run,filebrowser,window";
    font: "Fira Code SemiBold 12";
    show-icons: true;
    display-drun: "󰣇 Apps";
    display-run: " Run";
    display-filebrowser: " Files";
    display-window: " Windows";
}

/* ---- Window ---- */
window {
    width: 800px;
    height: 600px;
    x-offset: 0px;
    y-offset: 0px;
    spacing: 0px;
    padding: 0px;
    margin: 0px; 
    border: 2px;
    border-color: @active-background;
    border-radius: 15px;
    background-color: rgba(13, 14, 26, 0.7); /* Slightly transparent background */
}

/* ---- Mainbox ---- */
mainbox {
    padding: 20px;
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

/* ---- Inputbar ---- */
inputbar {
    padding: 15px;
    background-color: @normal-background;
    border-radius: 10px;
    children: [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color: @active-background;
    font: "Fira Code Bold 14";
}

entry {
    background-color: transparent;
    text-color: @normal-foreground;
    placeholder-color: @alternate-normal-foreground;
    placeholder: "Search...";
    font: "Fira Code 14";
    padding: 0px 10px;
}

/* ---- Listview ---- */
listview {
    padding: 20px 0px 0px 0px;
    background-color: transparent;
    columns: 2;
    lines: 8;
    spacing: 10px;
    scrollbar: false;
}

/* ---- Elements ---- */
element {
    padding: 10px;
    background-color: transparent;
    text-color: @normal-foreground;
    border-radius: 8px;
}

element selected {
    background-color: @active-background;
    text-color: @active-foreground;
}

element-icon {
    size: 32px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
