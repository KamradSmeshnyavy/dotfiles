# Block cursor smear. Put this file and smear-cursor-blocks.slang in ~/.config/kitty/shaders/
# and set `custom_shaders smear-blocks` (with `cursor_trail 1`) in kitty.conf.
startgroup
    animation_start cursor-trail-move
    # The trail is nearly invisible after ~6 / TAIL_RATE seconds (0.75 s for TAIL_RATE 8),
    # and barely visible after ~0.4 s. Raise this if you lower TAIL_RATE.
    animation_stop 800
    # 33 ms = ~30 fps. Use 16 for smoother motion at the cost of more GPU work.
    animation_step 16

    shaders smear-cursor-blocks-colored
endgroup
