# Block cursor smear. Put this file and smear-cursor-blocks.slang in ~/.config/kitty/shaders/
# and set `custom_shaders smear-blocks` (with `cursor_trail 1`) in kitty.conf.
startgroup
    animation_start cursor-trail-move
    # The smear is invisible after ~6 / TAIL_RATE seconds (0.75 s for TAIL_RATE 8).
    # default is 800
    animation_stop 500

    # 16 ms: the first frames (the "chaos" phase) last only ~25 ms.
    animation_step 33
    shaders smear-cursor-blocks
endgroup
