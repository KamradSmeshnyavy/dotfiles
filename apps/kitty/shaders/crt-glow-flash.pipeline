# CRT-style cursor glow flash. Put this file and crt-glow-flash.slang in
# ~/.config/kitty/shaders/ and set `custom_shaders crt-glow-flash` (with
# `cursor_trail 1`) in kitty.conf.
startgroup
    animation_start cursor-trail-move
    # This is a fast flash: with the default TIME_DURATION_FACTOR (1.0) it is
    # essentially gone by ~200ms. If you raise TIME_DURATION_FACTOR in the
    # shader, raise this roughly in proportion (e.g. 2.0 -> ~400).
    animation_stop 200
    # 16 ms: the whole effect only lasts ~150-200ms, so a fine step matters
    # here more than for a long-lived trail.
    animation_step 16

    # Colors: uncomment and edit. Values are sRGB, i.e. hex / 255.
    # Comments must stay on their own lines, not after a value.
    #
    # iris #c4a7e7
    # var float3 GLOW_COLOR_CURRENT = float3(0.769, 0.655, 0.906)
    # foam #9ccfd8
    # var float3 GLOW_COLOR_PREVIOUS = float3(0.612, 0.812, 0.847)
    #
    # Use kitty's real cursor/trail color instead of the two colors above,
    # only falling back to them when that color is close to grey:
    # var bool FORCE_OVERRIDE_COLORS = false
    
    # var float3 GLOW_COLOR_CURRENT = float3(0.769, 0.655, 0.906)   # iris, sRGB
    # var float3 GLOW_COLOR_PREVIOUS = float3(0.612, 0.812, 0.847)  # foam, sRGB


    shaders crt-glow-flash
endgroup
