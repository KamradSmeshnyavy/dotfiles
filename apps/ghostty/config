# ---- Рендеринг и Производительность ----
# Использовать Wayland как основной бэкенд
# window-system = wayland
# window-command = super

# Настройка вертикальной синхронизации для экрана ThinkPad (устраняет разрывы кадров)
# window-vsync = true

# Оптимизация обновления экрана. "true" снижает задержку ввода,
# заставляя терминал рендерить кадр сразу после изменения данных.
# rendering-driver = opengl
# font-thicken = true

# ---- Интеграция с Hyprland (Внешний вид) ----
# Отключение системных декораций окна (Hyprland сам управляет границами и тенями)
window-decoration = false

# Размытие заднего плана (работает в паре с правилами Hyprland ниже)
background-opacity = 0.85
background-blur = true

# ---- Буфер обмена и Мышь ----
clipboard-read = allow
clipboard-write = allow
mouse-hide-while-typing = true

adjust-cursor-thickness = 2

# auto-update-channel = tip
# Config generated by Ghostty Config
window-height = 24
window-width = 80
copy-on-select = true
window-save-state = always
# theme = dark:Catppuccin Mocha, light:TokyoNight
# theme = Catppuccin Mocha
theme = theme.conf
confirm-close-surface=false
# font-family
# font-family = RecMonoCasual Nerd Font
font-family = Maple Mono NF CN
# font-family = "RecMonoCasual Nerd Font"
font-size = 12
window-title-font-family = Maple Mono NF CN
# ss01: != and ===
font-feature = "ss01"
# ss02: <= and >=
font-feature = "ss02"
# ss03: -> and ~>
font-feature = "ss03"
# ss04: <> and </>
font-feature = "ss04"
# liga: //, ..., ||
font-feature = "liga"
# font-thicken = true
font-thicken-strength = 255

# background
# background-opacity = 0.80
# background-blur-radius = 20

link-url = true
link-previews = true

maximize = true
quick-terminal-position = center
# font-feature = -calt, -liga, -dlig

# shaders
custom-shader = ./my_shaders/cursor_efter.glsl
# custom-shader = ./cursors/warp.glsl
# custom-shader = ./shaders/smear_cursor_blocks.glsl
# custom-shader = ./my_shaders_new/cursor_warp.glsl
# custom-shader = ./shader_git/cursor_warp.glsl
# custom-shader = ./my_shaders_new/cursor_warp_mauve_trail.glsl
# custom-shader = ./shaders/glitchy.glsl
# custom-shader = ./shaders/glitchy.glsl
# custom-shader = ./shaders/retro-terminal.glsl
cursor-style = block
shell-integration-features = no-cursor

# keybinds
# key-remap = super=alt
# keybind = super+v=paste_from_clipboard
# keybind = performable:command+c=copy_to_clipboard
# keybind = alt+left=unbind
# keybind = alt+right=unbind
# keybind = super+r=reload_config
# # keybind = command+n=unbind
# keybind = command+w=unbind


# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u

# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
