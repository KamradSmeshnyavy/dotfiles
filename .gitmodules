[submodule "dotbot"]
	path = .dotbot
	url = https://github.com/anishathalye/dotbot
	ignore = dirty
[submodule "apps/ghostty/shaders"]
	path = apps/ghostty/shaders
	url = https://github.com/0xhckr/ghostty-shaders.git
[submodule "apps/ghostty/cursors"]
	path = apps/ghostty/cursors
	url = https://github.com/sahaj-b/ghostty-cursor-shaders
[submodule "apps/sketchybar"]
	path = apps/sketchybar
	url = my:sketchybar
[submodule "omarchy-themes/thinkpad-boot-screen"]
	path = omarchy-themes/thinkpad-boot-screen
	url = https://github.com/Yilmaz41/Thinkpad-boot-screen.git
[submodule "apps/omarchy-shell/plugins/kamradsmeshnyavy.bar"]
	path = apps/omarchy-shell/plugins/kamradsmeshnyavy.bar
	url = https://github.com/KamradSmeshnyavy/omarchy-bar-skins
[submodule "apps/omarchy-shell/plugins/kamradsmeshnyavy.lock"]
	path = apps/omarchy-shell/plugins/kamradsmeshnyavy.lock
	url = https://github.com/KamradSmeshnyavy/omarchy-lock-designs
[submodule "apps/omarchy-shell/plugins/kamradsmeshnyavy.background"]
	path = apps/omarchy-shell/plugins/kamradsmeshnyavy.background
	url = https://github.com/KamradSmeshnyavy/omarchy-wallpaper-fx
[submodule "apps/omarchy-shell/plugins/kamradsmeshnyavy.image-picker"]
	path = apps/omarchy-shell/plugins/kamradsmeshnyavy.image-picker
	url = https://github.com/KamradSmeshnyavy/omarchy-image-picker-styles
