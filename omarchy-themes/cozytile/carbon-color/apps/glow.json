{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#333333",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#72457f",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#CCCCCC",
		"background_color": "#72457f",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#555555"
	},
	"h3": {
		"prefix": "### ",
		"color": "#325879"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#325879"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#813e42"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#813e42",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#b1b1b1",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#325879",
		"underline": true
	},
	"link_text": {
		"color": "#72457f",
		"bold": true
	},
	"image": {
		"color": "#2b5c62",
		"underline": true
	},
	"image_text": {
		"color": "#707070",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#2b5c62",
		"background_color": "#b7b7b7"
	},
	"code_block": {
		"color": "#333333",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#333333"
			},
			"error": {
				"color": "#903434",
				"background_color": "#b7b7b7"
			},
			"comment": {
				"color": "#707070"
			},
			"comment_preproc": {
				"color": "#2b5c62"
			},
			"keyword": {
				"color": "#72457f"
			},
			"keyword_reserved": {
				"color": "#903434"
			},
			"keyword_namespace": {
				"color": "#615134"
			},
			"keyword_type": {
				"color": "#615134"
			},
			"operator": {
				"color": "#813e42"
			},
			"punctuation": {
				"color": "#525252"
			},
			"name": {
				"color": "#333333"
			},
			"name_builtin": {
				"color": "#615134"
			},
			"name_tag": {
				"color": "#72457f"
			},
			"name_attribute": {
				"color": "#325879"
			},
			"name_class": {
				"color": "#615134",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#615134"
			},
			"name_exception": {
				"color": "#903434"
			},
			"name_function": {
				"color": "#325879"
			},
			"name_other": {
				"color": "#333333"
			},
			"literal": {
				"color": "#813e42"
			},
			"literal_number": {
				"color": "#615134"
			},
			"literal_date": {
				"color": "#813e42"
			},
			"literal_string": {
				"color": "#485d3a"
			},
			"literal_string_escape": {
				"color": "#2b5c62"
			},
			"generic_deleted": {
				"color": "#903434"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#485d3a"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#525252"
			},
			"background": {
				"background_color": "#C2C2C2"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
