// Cozytile: omarchy-themes/cozytile/build.py по палитре темы
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/apps/cozytile-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 6
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;207;179;229",
      "title": "38;2;229;185;198",
      "output": "38;2;239;230;228"
    },
    "key": {
      "width": 8
    }
  },
  "modules": [
    {
      "type": "title",
      "key": " ",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "os",
      "format": "{name}"
    },
    {
      "type": "host",
      "key": "host",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    {
      "type": "packages",
      "key": "pkgs",
      "format": "{all}"
    },
    {
      "type": "memory",
      "key": "memory",
      "format": "{used} / {total}"
    }
  ]
}
