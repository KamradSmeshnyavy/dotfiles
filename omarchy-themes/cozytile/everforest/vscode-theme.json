  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#717778",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#8d9891"
      }
    },
    {
      "scope": [
        "keyword.control.flow",
        "keyword.control.return"
      ],
      "settings": {
        "foreground": "#8d9891",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#9fa7a1"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#E67E80"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language"
      ],
      "settings": {
        "foreground": "#D3C6AA"
      }
    },
    {
      "scope": [
        "constant",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#cac4b2"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#BDC2BE"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#c5c3b7"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "entity.other.attribute-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#8e9493"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#BDC2BE"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#BDC2BE",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#8d9891",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#8e9493"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#8d9891"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "entity.name.function.macro",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#E67E80"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#86918A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#BDC2BE",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#BDC2BE",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#c5c3b7",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.list.unnumbered",
        "markup.list.numbered",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#86918A"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8e9493",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#9fa7a1"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#E67E80"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#D3C6AA"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E67E80"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "#BDC2BE",
      "fontStyle": ""
    },
    "interface": {
      "foreground": "#BDC2BE",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#BDC2BE",
      "fontStyle": ""
    },
    "struct": {
      "foreground": "#BDC2BE",
      "fontStyle": ""
    },
    "type": {
      "foreground": "#BDC2BE",
      "fontStyle": ""
    },
    "typeParameter": {
      "foreground": "#BDC2BE",
      "fontStyle": "italic"
    },
    "namespace": "#BDC2BE",
    "function": "#c5c3b7",
    "method": "#c5c3b7",
    "macro": "#E67E80",
    "decorator": "#E67E80",
    "property": "#8e9493",
    "enumMember": "#cac4b2",
    "parameter": {
      "foreground": "#BDC2BE",
      "fontStyle": "italic"
    },
    "variable": "#BDC2BE",
    "variable.readonly": "#cac4b2",
    "keyword": {
      "foreground": "#8d9891",
      "fontStyle": ""
    },
    "string": "#9fa7a1",
    "number": "#D3C6AA",
    "regexp": "#E67E80",
    "operator": "#8e9493",
    "*.deprecated": {
      "fontStyle": "strikethrough"
    }
  }
}
