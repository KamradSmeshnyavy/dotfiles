  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#626968",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#C778DD"
      }
    },
    {
      "scope": [
        "keyword.control.flow",
        "keyword.control.return"
      ],
      "settings": {
        "foreground": "#C778DD",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#98C379"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#55B6C2"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language"
      ],
      "settings": {
        "foreground": "#E5C07A"
      }
    },
    {
      "scope": [
        "constant",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#EFCA84"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#E5C07A"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#62AEEF"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "entity.other.attribute-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E06B74"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#B2BEBC"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#B2BEBC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#C778DD",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#798280"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#C778DD"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "entity.name.function.macro",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#55B6C2"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#607767",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#B2BEBC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#B2BEBC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#62AEEF",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.list.unnumbered",
        "markup.list.numbered",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#607767"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#798280",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#98C379"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#C46A6A"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#B2BEBC"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#C46A6A"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "#E5C07A",
      "fontStyle": ""
    },
    "interface": {
      "foreground": "#E5C07A",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#E5C07A",
      "fontStyle": ""
    },
    "struct": {
      "foreground": "#E5C07A",
      "fontStyle": ""
    },
    "type": {
      "foreground": "#E5C07A",
      "fontStyle": ""
    },
    "typeParameter": {
      "foreground": "#E5C07A",
      "fontStyle": "italic"
    },
    "namespace": "#E5C07A",
    "function": "#62AEEF",
    "method": "#62AEEF",
    "macro": "#55B6C2",
    "decorator": "#55B6C2",
    "property": "#E06B74",
    "enumMember": "#EFCA84",
    "parameter": {
      "foreground": "#B2BEBC",
      "fontStyle": "italic"
    },
    "variable": "#B2BEBC",
    "variable.readonly": "#EFCA84",
    "keyword": {
      "foreground": "#C778DD",
      "fontStyle": ""
    },
    "string": "#98C379",
    "number": "#E5C07A",
    "regexp": "#55B6C2",
    "operator": "#798280",
    "*.deprecated": {
      "fontStyle": "strikethrough"
    }
  }
}
