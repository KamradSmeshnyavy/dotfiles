{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#B2BEBC",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#C778DD",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#0F1212",
		"background_color": "#C778DD",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#607767"
	},
	"h3": {
		"prefix": "### ",
		"color": "#62AEEF"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#62AEEF"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#E06B74"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#E06B74",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#323534",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#62AEEF",
		"underline": true
	},
	"link_text": {
		"color": "#C778DD",
		"bold": true
	},
	"image": {
		"color": "#55B6C2",
		"underline": true
	},
	"image_text": {
		"color": "#626968",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#55B6C2",
		"background_color": "#2c2e2e"
	},
	"code_block": {
		"color": "#B2BEBC",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#B2BEBC"
			},
			"error": {
				"color": "#C46A6A",
				"background_color": "#2c2e2e"
			},
			"comment": {
				"color": "#626968"
			},
			"comment_preproc": {
				"color": "#55B6C2"
			},
			"keyword": {
				"color": "#C778DD"
			},
			"keyword_reserved": {
				"color": "#C46A6A"
			},
			"keyword_namespace": {
				"color": "#E5C07A"
			},
			"keyword_type": {
				"color": "#E5C07A"
			},
			"operator": {
				"color": "#E06B74"
			},
			"punctuation": {
				"color": "#798280"
			},
			"name": {
				"color": "#B2BEBC"
			},
			"name_builtin": {
				"color": "#E5C07A"
			},
			"name_tag": {
				"color": "#C778DD"
			},
			"name_attribute": {
				"color": "#62AEEF"
			},
			"name_class": {
				"color": "#E5C07A",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#E5C07A"
			},
			"name_exception": {
				"color": "#C46A6A"
			},
			"name_function": {
				"color": "#62AEEF"
			},
			"name_other": {
				"color": "#B2BEBC"
			},
			"literal": {
				"color": "#E06B74"
			},
			"literal_number": {
				"color": "#E5C07A"
			},
			"literal_date": {
				"color": "#E06B74"
			},
			"literal_string": {
				"color": "#98C379"
			},
			"literal_string_escape": {
				"color": "#55B6C2"
			},
			"generic_deleted": {
				"color": "#C46A6A"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#98C379"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#798280"
			},
			"background": {
				"background_color": "#202222"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
