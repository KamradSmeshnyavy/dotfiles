{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#262524",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#c8102e",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#f4f4f2",
		"background_color": "#c8102e",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#d71921"
	},
	"h3": {
		"prefix": "### ",
		"color": "#000000"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#000000"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#44505a"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#44505a",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#d4d4d0",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#000000",
		"underline": true
	},
	"link_text": {
		"color": "#c8102e",
		"bold": true
	},
	"image": {
		"color": "#c4283f",
		"underline": true
	},
	"image_text": {
		"color": "#86837f",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#c4283f",
		"background_color": "#ffffff"
	},
	"code_block": {
		"color": "#262524",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#262524"
			},
			"error": {
				"color": "#c41e24",
				"background_color": "#ffffff"
			},
			"comment": {
				"color": "#86837f"
			},
			"comment_preproc": {
				"color": "#c4283f"
			},
			"keyword": {
				"color": "#c8102e"
			},
			"keyword_reserved": {
				"color": "#c41e24"
			},
			"keyword_namespace": {
				"color": "#b33a4c"
			},
			"keyword_type": {
				"color": "#9b1c2c"
			},
			"operator": {
				"color": "#44505a"
			},
			"punctuation": {
				"color": "#4f4d4b"
			},
			"name": {
				"color": "#262524"
			},
			"name_builtin": {
				"color": "#b33a4c"
			},
			"name_tag": {
				"color": "#c8102e"
			},
			"name_attribute": {
				"color": "#000000"
			},
			"name_class": {
				"color": "#9b1c2c",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#b33a4c"
			},
			"name_exception": {
				"color": "#c41e24"
			},
			"name_function": {
				"color": "#000000"
			},
			"name_other": {
				"color": "#262524"
			},
			"literal": {
				"color": "#44505a"
			},
			"literal_number": {
				"color": "#b33a4c"
			},
			"literal_date": {
				"color": "#44505a"
			},
			"literal_string": {
				"color": "#5e574f"
			},
			"literal_string_escape": {
				"color": "#c4283f"
			},
			"generic_deleted": {
				"color": "#c41e24"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#5e574f"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#4f4d4b"
			},
			"background": {
				"background_color": "#e9e9e6"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
