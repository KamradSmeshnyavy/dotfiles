{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#d6d3cf",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#ff4d55",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#000000",
		"background_color": "#ff4d55",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#d71921"
	},
	"h3": {
		"prefix": "### ",
		"color": "#ffffff"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#ffffff"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#a3a8ad"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#a3a8ad",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#2a2a2a",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#ffffff",
		"underline": true
	},
	"link_text": {
		"color": "#ff4d55",
		"bold": true
	},
	"image": {
		"color": "#e8636b",
		"underline": true
	},
	"image_text": {
		"color": "#686664",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#e8636b",
		"background_color": "#1a1a1a"
	},
	"code_block": {
		"color": "#d6d3cf",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#d6d3cf"
			},
			"error": {
				"color": "#ff4d55",
				"background_color": "#1a1a1a"
			},
			"comment": {
				"color": "#686664"
			},
			"comment_preproc": {
				"color": "#e8636b"
			},
			"keyword": {
				"color": "#ff4d55"
			},
			"keyword_reserved": {
				"color": "#ff4d55"
			},
			"keyword_namespace": {
				"color": "#ffb8b3"
			},
			"keyword_type": {
				"color": "#ff8a8a"
			},
			"operator": {
				"color": "#a3a8ad"
			},
			"punctuation": {
				"color": "#9c9894"
			},
			"name": {
				"color": "#d6d3cf"
			},
			"name_builtin": {
				"color": "#ffb8b3"
			},
			"name_tag": {
				"color": "#ff4d55"
			},
			"name_attribute": {
				"color": "#ffffff"
			},
			"name_class": {
				"color": "#ff8a8a",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#ffb8b3"
			},
			"name_exception": {
				"color": "#ff4d55"
			},
			"name_function": {
				"color": "#ffffff"
			},
			"name_other": {
				"color": "#d6d3cf"
			},
			"literal": {
				"color": "#a3a8ad"
			},
			"literal_number": {
				"color": "#ffb8b3"
			},
			"literal_date": {
				"color": "#a3a8ad"
			},
			"literal_string": {
				"color": "#b9b0a6"
			},
			"literal_string_escape": {
				"color": "#e8636b"
			},
			"generic_deleted": {
				"color": "#ff4d55"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#b9b0a6"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#9c9894"
			},
			"background": {
				"background_color": "#0b0b0b"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
