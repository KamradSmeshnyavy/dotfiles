{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#f0c997",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#d25a59",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#1c1612",
		"background_color": "#d25a59",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#c47c4f"
	},
	"h3": {
		"prefix": "### ",
		"color": "#6b8a97"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#6b8a97"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#989a9c"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#989a9c",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#3a2d22",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#6b8a97",
		"underline": true
	},
	"link_text": {
		"color": "#d25a59",
		"bold": true
	},
	"image": {
		"color": "#ae785a",
		"underline": true
	},
	"image_text": {
		"color": "#7b674e",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#ae785a",
		"background_color": "#3d2e21"
	},
	"code_block": {
		"color": "#f0c997",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#f0c997"
			},
			"error": {
				"color": "#b5746a",
				"background_color": "#3d2e21"
			},
			"comment": {
				"color": "#7b674e"
			},
			"comment_preproc": {
				"color": "#ae785a"
			},
			"keyword": {
				"color": "#d25a59"
			},
			"keyword_reserved": {
				"color": "#b5746a"
			},
			"keyword_namespace": {
				"color": "#d08b30"
			},
			"keyword_type": {
				"color": "#d68e60"
			},
			"operator": {
				"color": "#989a9c"
			},
			"punctuation": {
				"color": "#a68a68"
			},
			"name": {
				"color": "#f0c997"
			},
			"name_builtin": {
				"color": "#d08b30"
			},
			"name_tag": {
				"color": "#d25a59"
			},
			"name_attribute": {
				"color": "#6b8a97"
			},
			"name_class": {
				"color": "#d68e60",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#d08b30"
			},
			"name_exception": {
				"color": "#b5746a"
			},
			"name_function": {
				"color": "#6b8a97"
			},
			"name_other": {
				"color": "#f0c997"
			},
			"literal": {
				"color": "#989a9c"
			},
			"literal_number": {
				"color": "#d08b30"
			},
			"literal_date": {
				"color": "#989a9c"
			},
			"literal_string": {
				"color": "#858162"
			},
			"literal_string_escape": {
				"color": "#ae785a"
			},
			"generic_deleted": {
				"color": "#b5746a"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#858162"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#a68a68"
			},
			"background": {
				"background_color": "#2b221a"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
