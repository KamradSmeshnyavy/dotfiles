// Rumda: omarchy-themes/rumda/build.py по палитре темы
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/apps/rumda-logo.txt",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;208;139;48",
      "title": "38;2;214;142;96",
      "output": "38;2;240;201;151"
    },
    "key": {
      "width": 5
    }
  },
  "modules": [
    {
      "type": "title",
      "key": " ",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;120;77;55m┌─────────────────────────────┐"
    },
    {
      "type": "os",
      "key": "os",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "krn",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "up"
    },
    {
      "type": "packages",
      "key": "pkg"
    },
    {
      "type": "shell",
      "key": "sh",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;120;77;55m└─────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "  \u001b[38;2;58;45;34m● \u001b[38;2;61;46;33m● \u001b[38;2;120;77;55m● \u001b[38;2;154;66;53m● \u001b[38;2;196;124;79m● \u001b[38;2;214;142;96m● \u001b[38;2;240;201;151m● \u001b[0m"
    }
  ]
}
