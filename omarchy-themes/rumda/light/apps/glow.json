{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#4e2e1f",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#84543d",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#f5dcc6",
		"background_color": "#84543d",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#a1694d"
	},
	"h3": {
		"prefix": "### ",
		"color": "#5e3928"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#5e3928"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#71594a"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#71594a",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#f2bc88",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#5e3928",
		"underline": true
	},
	"link_text": {
		"color": "#84543d",
		"bold": true
	},
	"image": {
		"color": "#9a4235",
		"underline": true
	},
	"image_text": {
		"color": "#8d7666",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#9a4235",
		"background_color": "#f0bb90"
	},
	"code_block": {
		"color": "#4e2e1f",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#4e2e1f"
			},
			"error": {
				"color": "#9a4235",
				"background_color": "#f0bb90"
			},
			"comment": {
				"color": "#8d7666"
			},
			"comment_preproc": {
				"color": "#9a4235"
			},
			"keyword": {
				"color": "#84543d"
			},
			"keyword_reserved": {
				"color": "#9a4235"
			},
			"keyword_namespace": {
				"color": "#855740"
			},
			"keyword_type": {
				"color": "#4e2e1f"
			},
			"operator": {
				"color": "#71594a"
			},
			"punctuation": {
				"color": "#71594a"
			},
			"name": {
				"color": "#4e2e1f"
			},
			"name_builtin": {
				"color": "#855740"
			},
			"name_tag": {
				"color": "#84543d"
			},
			"name_attribute": {
				"color": "#5e3928"
			},
			"name_class": {
				"color": "#4e2e1f",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#855740"
			},
			"name_exception": {
				"color": "#9a4235"
			},
			"name_function": {
				"color": "#5e3928"
			},
			"name_other": {
				"color": "#4e2e1f"
			},
			"literal": {
				"color": "#71594a"
			},
			"literal_number": {
				"color": "#855740"
			},
			"literal_date": {
				"color": "#71594a"
			},
			"literal_string": {
				"color": "#784c36"
			},
			"literal_string_escape": {
				"color": "#9a4235"
			},
			"generic_deleted": {
				"color": "#9a4235"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#784c36"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#71594a"
			},
			"background": {
				"background_color": "#f2cdac"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
