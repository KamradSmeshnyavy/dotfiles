        "editor.inactiveSelectionBackground": "#151726",
        "editor.wordHighlightBackground": "#151726",
        "editor.findMatchBackground": "#c9a0dc",
        "editor.findMatchHighlightBackground": "#c9a0dc",
        "editor.lineHighlightBackground": "#0a0b14",
        "editorWhitespace.foreground": "#151726",
        "editorIndentGuide.background": "#151726",
        "editorIndentGuide.activeBackground": "#4a4d6a",

        "editorBracketMatch.background": "#151726",
        "editorBracketHighlight.foreground1": "#8dd4cc",
        "editorBracketHighlight.foreground2": "#c9a0dc",
        "editorBracketHighlight.foreground3": "#c9a0dc",
        "editorBracketHighlight.foreground4": "#f5cba7",
        "editorBracketHighlight.foreground5": "#f1948a",
        "editorBracketHighlight.foreground6": "#c9a0dc",

        "editorOverviewRuler.findMatchForeground": "#c9a0dc",
        "editorOverviewRuler.modifiedForeground": "#f5cba7",
        "editorOverviewRuler.addedForeground": "#c9a0dc",
        "editorOverviewRuler.errorForeground": "#f1948a",
        "editorOverviewRuler.warningForeground": "#f5cba7",

        "editorError.foreground": "#f1948a",
        "editorWarning.foreground": "#f5cba7",
        "editorInfo.foreground": "#8dd4cc",
