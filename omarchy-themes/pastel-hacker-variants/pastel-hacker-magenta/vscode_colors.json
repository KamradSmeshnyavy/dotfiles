        "diffEditor.insertedTextBackground": "#c9a0dc20",
        "diffEditor.removedTextBackground": "#f1948a20",

        "editorWidget.background": "#0d0e1a",
        "editorWidget.foreground": "#dcd7e6",
        "editorSuggestWidget.background": "#0d0e1a",
        "editorSuggestWidget.foreground": "#dcd7e6",
        "editorSuggestWidget.highlightForeground": "#c9a0dc",
        "editorSuggestWidget.selectedBackground": "#151726",
        "editorHoverWidget.background": "#0d0e1a",
        "editorHoverWidget.foreground": "#dcd7e6",

        "panel.background": "#0d0e1a",
        "panelTitle.activeForeground": "#dcd7e6",
        "panelTitle.inactiveForeground": "#4a4d6a",

        "statusBar.background": "#c9a0dc",
        "statusBar.foreground": "#0d0e1a",
        "statusBar.debuggingBackground": "#c9a0dc",
        "statusBar.debuggingForeground": "#0d0e1a",
        "statusBar.noFolderBackground": "#151726",
        "statusBar.noFolderForeground": "#dcd7e6",
        "statusBarItem.activeBackground": "#151726",
        "statusBarItem.hoverBackground": "#151726",
        "statusBarItem.remoteBackground": "#8dd4cc",
        "statusBarItem.remoteForeground": "#0d0e1a",

        "titleBar.activeBackground": "#0d0e1a",
        "titleBar.activeForeground": "#dcd7e6",
        "titleBar.inactiveBackground": "#0a0b14",
        "titleBar.inactiveForeground": "#4a4d6a",

        "menubar.selectionForeground": "#dcd7e6",
        "menubar.selectionBackground": "#151726",
        "menu.foreground": "#dcd7e6",
        "menu.background": "#0d0e1a",
        "menu.selectionForeground": "#dcd7e6",
        "menu.selectionBackground": "#151726",

        "notificationCenterHeader.foreground": "#dcd7e6",
        "notificationCenterHeader.background": "#0d0e1a",
        "notifications.foreground": "#dcd7e6",
        "notifications.background": "#151726",
        "notificationLink.foreground": "#8dd4cc",

        "commandCenter.foreground": "#dcd7e6",
        "commandCenter.activeForeground": "#ffffff",
        "commandCenter.background": "#151726",
        "commandCenter.activeBackground": "#151726",

        "terminal.background": "#0d0e1a",
        "terminal.foreground": "#dcd7e6",
        "terminal.ansiBlack": "#0d0e1a",
        "terminal.ansiRed": "#f1948a",
        "terminal.ansiGreen": "#c9a0dc",
        "terminal.ansiYellow": "#f5cba7",
        "terminal.ansiBlue": "#c9a0dc",
        "terminal.ansiMagenta": "#c9a0dc",
        "terminal.ansiCyan": "#8dd4cc",
        "terminal.ansiWhite": "#dcd7e6",
        "terminal.ansiBrightBlack": "#4a4d6a",
        "terminal.ansiBrightRed": "#f1948a",
        "terminal.ansiBrightGreen": "#c9a0dc",
        "terminal.ansiBrightYellow": "#f5cba7",
        "terminal.ansiBrightBlue": "#c9a0dc",
        "terminal.ansiBrightMagenta": "#c9a0dc",
        "terminal.ansiBrightCyan": "#8dd4cc",
        "terminal.ansiBrightWhite": "#ffffff",
        "terminalCursor.foreground": "#c9a0dc",

        "debugToolBar.background": "#151726",
        "debugIcon.startForeground": "#c9a0dc",
        "debugIcon.pauseForeground": "#8dd4cc",
        "debugIcon.stopForeground": "#f1948a",
        "debugIcon.restartForeground": "#c9a0dc",

        "gitDecoration.addedResourceForeground": "#c9a0dc",
        "gitDecoration.modifiedResourceForeground": "#f5cba7",
        "gitDecoration.deletedResourceForeground": "#f1948a",
        "gitDecoration.untrackedResourceForeground": "#8dd4cc",
        "gitDecoration.ignoredResourceForeground": "#4a4d6a",
        "gitDecoration.conflictingResourceForeground": "#c9a0dc",

        "settings.headerForeground": "#dcd7e6",
        "settings.modifiedItemIndicator": "#c9a0dc",
        "settings.dropdownBackground": "#151726",
        "settings.dropdownForeground": "#dcd7e6",
        "settings.checkboxBackground": "#151726",
        "settings.checkboxForeground": "#dcd7e6",
        "settings.textInputBackground": "#151726",
        "settings.textInputForeground": "#dcd7e6",
        "settings.numberInputBackground": "#151726",
        "settings.numberInputForeground": "#dcd7e6",

        "breadcrumb.foreground": "#dcd7e6",
        "breadcrumb.background": "#0d0e1a",
        "breadcrumb.focusForeground": "#ffffff",
        "breadcrumbPicker.background": "#0d0e1a",

        "notebook.editorBackground": "#0d0e1a",
        "notebook.cellBorderColor": "#151726",
        "notebook.cellHoverBackground": "#151726",
        "notebook.focusedCellBorder": "#c9a0dc",
        "notebook.selectedCellBackground": "#151726",

        "charts.foreground": "#dcd7e6",
        "charts.lines": "#dcd7e6",
        "charts.red": "#f1948a",
        "charts.blue": "#8dd4cc",
        "charts.yellow": "#f5cba7",
        "charts.green": "#c9a0dc",
        "charts.purple": "#c9a0dc"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#4a4d6a" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.parameter"],
            "settings": { "foreground": "#f1948a" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.modifier", "keyword.control"],
            "settings": { "foreground": "#c9a0dc" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "meta.function-call", "support.function"],
            "settings": { "foreground": "#8dd4cc" }
        },
        {
            "name": "String",
            "scope": ["string"],
            "settings": { "foreground": "#c9a0dc" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#c9a0dc" }
        },
        {
            "name": "Type",
            "scope": ["entity.name.type", "support.type", "storage.type"],
            "settings": { "foreground": "#f5cba7" }
        },
        {
            "name": "Class",
            "scope": ["entity.name.class", "support.class"],
            "settings": { "foreground": "#f5cba7" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#f1948a" }
        },
        {
            "name": "Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#8dd4cc" }
        },
        {
            "name": "Constant",
            "scope": ["constant", "support.constant"],
            "settings": { "foreground": "#c9a0dc" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator", "punctuation"],
            "settings": { "foreground": "#c9a0dc" }
        },
        {
            "name": "Embedded",
            "scope": ["punctuation.section.embedded", "variable.interpolation"],
            "settings": { "foreground": "#c9a0dc" }
        },
        {
            "name": "Markup Heading",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#8dd4cc", "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#c9a0dc" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#c9a0dc" }
        },
        {
            "name": "Markup Link",
            "scope": ["string.other.link", "markup.underline"],
            "settings": { "foreground": "#8dd4cc" }
        },
        {
            "name": "Markup List",
            "scope": ["punctuation.definition.list_item"],
            "settings": { "foreground": "#c9a0dc" }
        },
        {
            "name": "Markup Quote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#4a4d6a", "fontStyle": "italic" }
        },
        {
            "name": "Markup Raw",
            "scope": ["markup.raw", "markup.inline.raw"],
            "settings": { "foreground": "#c9a0dc" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#8dd4cc" }
        },
        {
            "name": "JSON Key",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#8dd4cc" }
        }
    ]
}
