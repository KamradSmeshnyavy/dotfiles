#!/usr/bin/env bash
# Темы CLI/TUI-приложений, которые Omarchy сам не перекрашивает.
# Каждый слот — симлинк на apps/<файл> текущей темы, а если его нет — на сгенерированный файл
# (yatline.lua из colors.toml) или на app-defaults/<файл>.
# apps/env (KEY=VALUE, {theme} → путь к текущей теме) превращается в app-theme.zsh и app-theme.json (nushell).
set -u

THEME=${OMARCHY_APP_THEME_DIR:-$HOME/.local/state/omarchy/current/theme}
STATE=$HOME/.local/state/omarchy
SCRIPTS=$(dirname "$(readlink -f "$0")")
DEFAULTS=$(cd "$SCRIPTS/../app-defaults" && pwd) || exit 1

declare -A SLOTS=(
  [yazi.toml]=$HOME/.config/yazi/theme.toml
  [yazi-flavor]=$HOME/.config/yazi/flavors/omarchy.yazi
  [yatline.lua]=$HOME/.config/yazi/plugins/yatline-omarchy.yazi/main.lua
  [lazygit.yml]=$HOME/.config/lazygit/theme.yml
  [atuin.toml]=$HOME/.config/atuin/themes/omarchy.toml
  [lla.toml]=$HOME/.config/lla/themes/omarchy.toml
  [television.toml]=$HOME/.config/television/themes/omarchy.toml
  [gitui.ron]=$HOME/.config/gitui/theme.ron
  [rmpc.ron]=$HOME/.config/rmpc/themes/omarchy.ron
  [nushell.nu]=$HOME/.config/nushell/themes/omarchy.nu
  [tmux.conf]=$HOME/.config/tmux/om-app-theme.conf
  # не в ~/.config: путь задан в FZF_DEFAULT_OPTS_FILE (env.nu, .zshrc)
  [fzf.opts]=$STATE/app-themes/fzf.opts
)

# Файлы, которые omarchy-theme-set сам рендерит в корень темы из omarchy-themes/themed/*.tpl
# (~/.config/omarchy/themed). У темы без colors.toml их нет — слот тогда не трогается.
# qt6ct-colors.conf подключает write_qt6ct.
declare -A TEMPLATED=(
  [vesktop.css]=$HOME/.config/vesktop/themes/omarchy.css
  [mpv-osc.conf]=$HOME/.config/mpv/script-opts/osc.conf
)

# Слоты, которые для темы без своего файла генерируются из её colors.toml
declare -A GENERATED=()

# generate_one <файл в apps/> <генератор>: только если у темы нет своего файла
generate_one() {
  local name=$1 generator=$2 out tmp
  [[ -e $THEME/apps/$name || ! -f $THEME/colors.toml ]] && return
  out=$STATE/app-themes/generated-$name
  mkdir -p "$STATE/app-themes"
  tmp=$(mktemp "$STATE/app-themes/.$name.XXXXXX") || return
  if "$SCRIPTS/$generator" "$THEME" "$tmp"; then
    mv -f "$tmp" "$out"
    GENERATED[$name]=$out
  else
    mv -f "$tmp" "$tmp.failed"
  fi
}

generate() {
  generate_one yatline.lua omarchy-yatline-theme
  generate_one fzf.opts omarchy-fzf-theme
}

# link_slot <слот> <источник>
link_slot() {
  local slot=$1 src=$2 rel
  # ~/.config/<app> нет — приложение не настроено, слот не нужен
  if [[ $slot == "$HOME/.config/"* ]]; then
    rel=${slot#"$HOME/.config/"}
    [[ -e $HOME/.config/${rel%%/*} ]] || return 0
  fi

  if [[ -e $slot && ! -L $slot ]]; then
    echo "omarchy-app-themes: $slot — обычный файл, не трогаю" >&2
    return 0
  fi
  mkdir -p "$(dirname "$slot")"
  ln -sfn "$src" "$slot"
}

link_slots() {
  local name src
  for name in "${!SLOTS[@]}"; do
    src=$THEME/apps/$name
    [[ -e $src ]] || src=${GENERATED[$name]:-$DEFAULTS/$name}
    link_slot "${SLOTS[$name]}" "$src"
  done
  for name in "${!TEMPLATED[@]}"; do
    [[ -e $THEME/$name ]] && link_slot "${TEMPLATED[$name]}" "$THEME/$name"
  done
}

# Курсор: apps/cursor темы («ИМЯ РАЗМЕР»), иначе app-defaults/cursor (или cursor-light для mode = "light").
# Строка сохраняется в state — по ней env.lua ставит XCURSOR_* при следующем входе.
apply_cursor() {
  local file=$THEME/apps/cursor name size dir found=
  if [[ ! -f $file ]]; then
    file=$DEFAULTS/cursor
    grep -qE '^mode *= *"light"' "$THEME/colors.toml" 2>/dev/null && file=$DEFAULTS/cursor-light
  fi
  read -r name size <"$file" || return 0
  size=${size:-24}
  for dir in "$HOME/.local/share/icons" "$HOME/.icons" /usr/share/icons; do
    [[ -d $dir/$name/cursors ]] && found=1
  done
  if [[ -z $found ]]; then
    echo "omarchy-app-themes: курсор $name не установлен" >&2
    return 0
  fi

  mkdir -p "$STATE/app-themes"
  printf '%s %s\n' "$name" "$size" >"$STATE/app-themes/cursor"
  hyprctl setcursor "$name" "$size" >/dev/null 2>&1 || true
  gsettings set org.gnome.desktop.interface cursor-theme "$name" 2>/dev/null || true
  gsettings set org.gnome.desktop.interface cursor-size "$size" 2>/dev/null || true
}

# qt6ct.conf (генерируется, не в репо): палитра темы + иконки темы. Только если qt6ct установлен.
write_qt6ct() {
  command -v qt6ct >/dev/null || return 0
  [[ -e $THEME/qt6ct-colors.conf ]] || return 0
  local conf=$HOME/.config/qt6ct/qt6ct.conf icons=
  [[ -f $THEME/icons.theme ]] && icons=$(<"$THEME/icons.theme")
  mkdir -p "$HOME/.config/qt6ct/colors"
  ln -sfn "$THEME/qt6ct-colors.conf" "$HOME/.config/qt6ct/colors/omarchy.conf"
  {
    echo "# Сгенерировано omarchy-app-themes при смене темы — правки перезапишутся"
    echo "[Appearance]"
    echo "color_scheme_path=$HOME/.config/qt6ct/colors/omarchy.conf"
    echo "custom_palette=true"
    echo "style=Fusion"
    [[ -n $icons ]] && echo "icon_theme=$icons"
  } >"$conf"
}

write_env() {
  local env_file=$THEME/apps/env
  [[ -f $env_file ]] || env_file=$DEFAULTS/env

  local tmp_dir
  tmp_dir=$(mktemp -d "$STATE/.app-theme.XXXXXX") || return
  python3 -I - "$env_file" "$THEME" "$tmp_dir" <<'PY'
import json, shlex, sys
env_file, theme, out = sys.argv[1:]
env = {}
for line in open(env_file, encoding="utf-8"):
    line = line.strip()
    if not line or line.startswith("#") or "=" not in line:
        continue
    key, value = line.split("=", 1)
    env[key.strip()] = value.strip().replace("{theme}", theme)
with open(f"{out}/app-theme.json", "w") as f:
    json.dump(env, f, indent=2)
with open(f"{out}/app-theme.zsh", "w") as f:
    f.write("# Сгенерировано omarchy-app-themes\n")
    f.writelines(f"export {k}={shlex.quote(v)}\n" for k, v in env.items())
PY
  mv -f "$tmp_dir/app-theme.json" "$STATE/app-theme.json"
  mv -f "$tmp_dir/app-theme.zsh" "$STATE/app-theme.zsh"
  rmdir "$tmp_dir"
}

reload_tmux() {
  tmux list-sessions >/dev/null 2>&1 || return 0
  local conf
  for conf in "$HOME/.config/tmux/om-theme.conf" "$HOME/.config/tmux/om-app-theme.conf"; do
    [[ -e $conf ]] && tmux source-file "$conf"
  done
  tmux refresh-client -S 2>/dev/null || true
}

generate
link_slots
apply_cursor
write_qt6ct
write_env
reload_tmux
