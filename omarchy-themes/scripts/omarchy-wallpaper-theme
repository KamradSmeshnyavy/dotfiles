#!/usr/bin/python3
"""
Тема Omarchy «dynamic» из обоев — обёртка над `omarchy-rice-dynamic build plain` (Iris, все режимы dynamic).

Использование: omarchy-wallpaper-theme [ОБОИ] [--scheme РЕЖИМ] [--mode dark|light|auto] [--no-apply]

Без ОБОЕВ берутся текущие. Прежние имена схем matugen (tonal-spot, vibrant, monochrome, …) переводятся в режимы
dynamic (wallpaper, vivid, grey, …); --prefer и --contrast matugen больше не нужны и принимаются молча. Это разовая
сборка: запомнить режим для перекраски при смене обоев — `omarchy-rice-dynamic set plain --scheme …`.
"""
import argparse
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent


def main():
    ap = argparse.ArgumentParser(description=__doc__.strip().splitlines()[0])
    ap.add_argument("image", nargs="?")
    ap.add_argument("--scheme")
    ap.add_argument("--mode", choices=["dark", "light", "auto"])
    ap.add_argument("--prefer")      # matugen, больше не нужен
    ap.add_argument("--contrast")    # matugen, больше не нужен
    ap.add_argument("--no-apply", action="store_true", help="только записать тему")
    args = ap.parse_args()
    cmd = [str(HERE / "omarchy-rice-dynamic"), "build", "plain"]
    if args.image:
        cmd.append(args.image)
    if args.scheme:
        cmd += ["--scheme", args.scheme]  # omarchy-rice-dynamic принимает и прежние имена (алиасы)
    if args.mode:
        cmd += ["--mode", args.mode]
    if args.no_apply:
        cmd.append("--no-apply")
    os.execv(cmd[0], cmd)


if __name__ == "__main__":
    sys.exit(main())
