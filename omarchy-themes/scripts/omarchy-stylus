#!/usr/bin/python3 -I
"""
Стили Stylus (официальные userstyles Catppuccin) в цветах текущей темы Omarchy.

Шаблон — browser-templates/catppuccin/stylus-import.json (экспорт с сайта Catppuccin).
Для темы меняются только цвета: в каждом стиле после подключения библиотеки
userstyles.catppuccin.com/lib/std/v1.less палитра всех вариантов (latte, frappe,
macchiato, mocha) переопределяется цветами colors.toml, вместе с CSS-фильтрами для
иконок, а акцентом становится accent темы.

Готовые стили лежат в ~/.local/state/omarchy/stylus/www/<slug>.user.css, их отдаёт
omarchy-stylus-server.service на http://127.0.0.1:47860–47875. У каждого стиля @updateURL
указывает туда; для localhost Stylus подтягивает изменённый код без смены версии.
Автопроверка Stylus стоит раз в год. Новые стили действуют сразу при запуске браузера:
  * Firefox — пока он закрыт, стили собираются тем же кодом Stylus (stylus-compile.cjs,
    node) и пишутся прямо в его базу IndexedDB (firefox_idb.py);
  * Helium — обёртка helium-browser запускает его через `helium-launch`: по pipe CDP
    (без порта) Stylus сразу проверяет обновления.
Запасной путь — `prime`: Stylus сам проверит обновления через минуту после запуска.
Стили, которые раньше отдавались, а в текущем наборе их нет, заменяются пустой
заглушкой и перестают действовать.

Один раз: импортировать www/import.json в Stylus (Управление → Импорт).

Использование:
  omarchy-stylus sync              # из хука theme-set: пересобрать стили под тему
  omarchy-stylus prime [браузер]   # пока браузер закрыт: Firefox — записать стили, Helium — prime
  omarchy-stylus helium-launch [аргументы]  # из обёртки helium-browser: запуск Helium
  omarchy-stylus palette [colors]  # напечатать палитру Catppuccin для colors.toml
"""
import copy
import hashlib
import json
import math
import os
import random
import re
import sys
import time
import tomllib
from pathlib import Path

HOME = Path.home()
THEME_DIR = HOME / ".local/state/omarchy/current/theme"
STATE = HOME / ".local/state/omarchy/stylus"
WWW = STATE / "www"
LOG = STATE / "log.txt"
SERVED = STATE / "served.json"
FILTER_CACHE = STATE / "filters.json"
TEMPLATE = Path(__file__).resolve().parent.parent / "browser-templates/catppuccin/stylus-import.json"
# Библиотека userstyles.catppuccin.com/lib/std/v1.less встраивается в каждый стиль: воркер
# Stylus в Helium не загружает удалённый @import, и сборка давала «Style is empty».
LIB = TEMPLATE.with_name("lib-std-v1.less")
# Порты omarchy-stylus-serve: Stylus выдерживает 1 с между запросами к одному host:port,
# поэтому стили разложены по 16 портам (порт стиля постоянен — от хэша имени).
FIRST_PORT, PORTS = 47860, 16
# Автопроверка Stylus фактически выключена (раз в год): стили обновляются один раз
# после смены темы — `prime` перед запуском Helium сбрасывает дату последней проверки.
UPDATE_INTERVAL_HOURS = 8760
BUILD = STATE / "build.json"
PRIMED = STATE / "primed.json"
HELIUM_STYLUS_STORE = HOME / ".config/net.imput.helium/Default/Local Extension Settings/clngdbkpkpeebahjckkjfobafhncgmne"

ROLES = ["rosewater", "flamingo", "pink", "mauve", "red", "maroon", "peach", "yellow", "green",
         "teal", "sky", "sapphire", "blue", "lavender", "text", "subtext1", "subtext0", "overlay2",
         "overlay1", "overlay0", "surface2", "surface1", "surface0", "base", "mantle", "crust"]
FLAVORS = ["latte", "frappe", "macchiato", "mocha"]
RX_LIB = re.compile(r'^@import\s+"https://userstyles\.catppuccin\.com/lib/[^"]+";[^\n]*\n', re.M)
RX_META = re.compile(r"/\*\s*==UserStyle==.*?==/UserStyle==\s*\*/", re.S)
MARK = "/* omarchy palette */"


def log(msg):
    STATE.mkdir(parents=True, exist_ok=True)
    line = f"{time.strftime('%F %T')} {msg}"
    with open(LOG, "a") as f:
        f.write(line + "\n")
    print(line, file=sys.stderr)


def load_json(path, default):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default


def write_atomic(path, text):
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


# --- палитра ----------------------------------------------------------------

def hex_rgb(value):
    h = value.strip().lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def mix(a, b, amount):
    ra, rb = hex_rgb(a), hex_rgb(b)
    return "#" + "".join(f"{round(x * (1 - amount) + y * amount):02x}" for x, y in zip(ra, rb))


def palette(colors_path):
    """Роли Catppuccin из colors.toml темы Omarchy."""
    with open(colors_path, "rb") as f:
        data = tomllib.load(f)
    col = data.get("colors", data)

    def pick(*keys, default):
        for k in keys:
            v = col.get(k)
            if isinstance(v, str) and v.startswith("#") and len(v) == 7:
                return v.lower()
        return default

    bg = pick("background", default="#1e1e2e")
    fg = pick("foreground", default="#cdd6f4")
    red = pick("red", "color1", default="#f38ba8")
    green = pick("green", "color2", default="#a6e3a1")
    yellow = pick("yellow", "color3", default="#f9e2af")
    blue = pick("blue", "color4", default="#89b4fa")
    magenta = pick("magenta", "color5", default="#cba6f7")
    cyan = pick("cyan", "color6", default="#94e2d5")
    accent = pick("accent", default=blue)
    return {
        "rosewater": pick("cursor", default=mix(fg, red, 0.25)),
        "flamingo": pick("brown", default=mix(fg, red, 0.4)),
        "pink": pick("bright_magenta", "color13", default=mix(magenta, fg, 0.3)),
        "mauve": magenta,
        "red": red,
        "maroon": pick("bright_red", "color9", default=mix(red, fg, 0.2)),
        "peach": pick("orange", default=mix(red, yellow, 0.5)),
        "yellow": yellow,
        "green": green,
        "teal": cyan,
        "sky": mix(cyan, blue, 0.4),
        "sapphire": mix(cyan, blue, 0.7),
        "blue": blue,
        "lavender": accent,
        "text": fg,
        "subtext1": pick("light_foreground", default=mix(bg, fg, 0.85)),
        "subtext0": mix(bg, fg, 0.72),
        "overlay2": mix(bg, fg, 0.60),
        "overlay1": mix(bg, fg, 0.50),
        "overlay0": pick("dark_foreground", default=mix(bg, fg, 0.40)),
        "surface2": pick("muted", default=mix(bg, fg, 0.28)),
        "surface1": pick("selection", default=mix(bg, fg, 0.20)),
        "surface0": pick("lighter_background", default=mix(bg, fg, 0.12)),
        "base": bg,
        "mantle": pick("dark_background", default=mix(bg, "#000000", 0.15)),
        "crust": pick("darker_background", default=mix(bg, "#000000", 0.30)),
    }


# --- CSS-фильтр «чёрный → цвет» для иконок (как @catppuccin-filters) ---------
# Порт известного решателя SPSA (codepen.io/sosuke/pen/Pjoqqp).

class _Color:
    def __init__(self, r, g, b):
        self.r, self.g, self.b = r, g, b

    def clamp(self):
        self.r, self.g, self.b = (min(255, max(0, v)) for v in (self.r, self.g, self.b))

    def _multiply(self, m):
        r, g, b = self.r, self.g, self.b
        self.r = r * m[0] + g * m[1] + b * m[2]
        self.g = r * m[3] + g * m[4] + b * m[5]
        self.b = r * m[6] + g * m[7] + b * m[8]
        self.clamp()

    def hue_rotate(self, angle):
        a = angle / 180 * math.pi
        s, c = math.sin(a), math.cos(a)
        self._multiply([
            0.213 + c * 0.787 - s * 0.213, 0.715 - c * 0.715 - s * 0.715, 0.072 - c * 0.072 + s * 0.928,
            0.213 - c * 0.213 + s * 0.143, 0.715 + c * 0.285 + s * 0.140, 0.072 - c * 0.072 - s * 0.283,
            0.213 - c * 0.213 - s * 0.787, 0.715 - c * 0.715 + s * 0.715, 0.072 + c * 0.928 + s * 0.072])

    def sepia(self, v):
        self._multiply([
            0.393 + 0.607 * (1 - v), 0.769 - 0.769 * (1 - v), 0.189 - 0.189 * (1 - v),
            0.349 - 0.349 * (1 - v), 0.686 + 0.314 * (1 - v), 0.168 - 0.168 * (1 - v),
            0.272 - 0.272 * (1 - v), 0.534 - 0.534 * (1 - v), 0.131 + 0.869 * (1 - v)])

    def saturate(self, v):
        self._multiply([
            0.213 + 0.787 * v, 0.715 - 0.715 * v, 0.072 - 0.072 * v,
            0.213 - 0.213 * v, 0.715 + 0.285 * v, 0.072 - 0.072 * v,
            0.213 - 0.213 * v, 0.715 - 0.715 * v, 0.072 + 0.928 * v])

    def _linear(self, slope, intercept=0.0):
        self.r = self.r * slope + intercept * 255
        self.g = self.g * slope + intercept * 255
        self.b = self.b * slope + intercept * 255
        self.clamp()

    def brightness(self, v):
        self._linear(v)

    def contrast(self, v):
        self._linear(v, -(0.5 * v) + 0.5)

    def invert(self, v):
        self.r = (v + self.r / 255 * (1 - 2 * v)) * 255
        self.g = (v + self.g / 255 * (1 - 2 * v)) * 255
        self.b = (v + self.b / 255 * (1 - 2 * v)) * 255
        self.clamp()

    def hsl(self):
        r, g, b = self.r / 255, self.g / 255, self.b / 255
        mx, mn = max(r, g, b), min(r, g, b)
        h = s = 0.0
        l = (mx + mn) / 2
        if mx != mn:
            d = mx - mn
            s = d / (2 - mx - mn) if l > 0.5 else d / (mx + mn)
            if mx == r:
                h = (g - b) / d + (6 if g < b else 0)
            elif mx == g:
                h = (b - r) / d + 2
            else:
                h = (r - g) / d + 4
            h /= 6
        return h * 100, s * 100, l * 100


def _apply(f):
    c = _Color(0, 0, 0)
    c.invert(f[0] / 100)
    c.sepia(f[1] / 100)
    c.saturate(f[2] / 100)
    c.hue_rotate(f[3] * 3.6)
    c.brightness(f[4] / 100)
    c.contrast(f[5] / 100)
    return c


def _loss(f, target, target_hsl):
    c = _apply(f)
    h, s, l = c.hsl()
    return (abs(c.r - target.r) + abs(c.g - target.g) + abs(c.b - target.b)
            + abs(h - target_hsl[0]) + abs(s - target_hsl[1]) + abs(l - target_hsl[2]))


def _spsa(A, a, c, values, iters, target, target_hsl, rnd):
    alpha, gamma = 1, 1 / 6
    best, best_loss = None, math.inf
    values = list(values)
    for k in range(iters):
        ck = c / (k + 1) ** gamma
        deltas = [1 if rnd.random() > 0.5 else -1 for _ in range(6)]
        high = [v + ck * d for v, d in zip(values, deltas)]
        low = [v - ck * d for v, d in zip(values, deltas)]
        diff = _loss(high, target, target_hsl) - _loss(low, target, target_hsl)
        for i in range(6):
            g = diff / (2 * ck) * deltas[i]
            ak = a[i] / (A + k + 1) ** alpha
            v = values[i] - ak * g
            mx = 7500 if i == 2 else 200 if i in (4, 5) else 100
            if i == 3:
                v = v % mx if v > mx else (v % mx + mx if v < 0 else v)
            else:
                v = min(mx, max(0, v))
            values[i] = v
        cur = _loss(values, target, target_hsl)
        if cur < best_loss:
            best, best_loss = list(values), cur
    return best, best_loss


def css_filter(hex_color):
    rnd = random.Random(int(hashlib.sha1(hex_color.encode()).hexdigest()[:8], 16))
    target = _Color(*hex_rgb(hex_color))
    thsl = target.hsl()
    best, best_loss = None, math.inf
    for _ in range(30):
        vals, loss = _spsa(5, [60, 180, 18000, 600, 1.2, 1.2], 15, [50, 20, 3750, 50, 100, 100],
                           1000, target, thsl, rnd)
        if loss < best_loss:
            best, best_loss = vals, loss
        if best_loss <= 25:
            break
    A = best_loss
    c = 2 + A / 10
    a = [0.25 * A, 0.25 * A, A, 0.25 * A, 0.2 * A, 0.2 * A]
    vals, loss = _spsa(A, a, c, best, 500, target, thsl, rnd)
    if loss < best_loss:
        best = vals
    f = best
    return (f"brightness(0) saturate(100%) invert({round(f[0])}%) sepia({round(f[1])}%) "
            f"saturate({round(f[2])}%) hue-rotate({round(f[3] * 3.6)}deg) "
            f"brightness({round(f[4])}%) contrast({round(f[5])}%)")


def filters(pal):
    cache = load_json(FILTER_CACHE, {})
    out = {}
    for role in ROLES:
        color = pal[role]
        if color not in cache:
            cache[color] = css_filter(color)
        out[role] = cache[color]
    STATE.mkdir(parents=True, exist_ok=True)
    write_atomic(FILTER_CACHE, json.dumps(cache, indent=1) + "\n")
    return out


# --- стили ------------------------------------------------------------------

def style_url(name):
    port = FIRST_PORT + int(hashlib.sha1(name.encode()).hexdigest(), 16) % PORTS
    return f"http://127.0.0.1:{port}/{name}.user.css"


def slug(name):
    s = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    return s or "style"


def set_update_url(code, url):
    """Ставит @updateURL в мета-блоке usercss (заменяет или добавляет)."""
    m = RX_META.search(code)
    if not m:
        return code
    meta = m.group(0)
    if re.search(r"^@updateURL\s", meta, re.M):
        meta = re.sub(r"^@updateURL\s.*$", f"@updateURL {url}", meta, flags=re.M)
    else:
        meta = meta.replace("==/UserStyle==", f"@updateURL {url}\n==/UserStyle==", 1)
    return code[:m.start()] + meta + code[m.end():]


def override_block(pal, flt):
    colors = " ".join(f"@{r}: {pal[r]};" for r in ROLES)
    filt = " ".join(f"@{r}: {flt[r]};" for r in ROLES)
    lines = [MARK, "@catppuccin: {"]
    lines += [f"  @{fl}: {{ {colors} }};" for fl in FLAVORS]
    lines += ["};", "@catppuccin-filters: {"]
    lines += [f"  @{fl}: {{ {filt} }};" for fl in FLAVORS]
    lines += ["};", "@accentColor: lavender;", ""]
    return "\n".join(lines)


def stub(name, url):
    return (f"/* ==UserStyle==\n@name {name}\n@namespace omarchy/stylus/{slug(name)}\n@version 0.0.0\n"
            f"@description Removed by omarchy-stylus: not in the current style set\n"
            f"@updateURL {url}\n==/UserStyle== */\n\n"
            f"@-moz-document domain(\"omarchy-stylus.invalid\") {{\n}}\n")


FONTS_JSON = HOME / ".config/omarchy/fonts.json"
DOT = '"Nihil Dot", "Doto", monospace'
# Что набирать точками / пикселями по профилю шрифтов (omarchy-font-profile).
FONT_RULES = {
    "nothing": {"dot": "h1, h2"},
    "dot": {"dot": "h1, h2, h3, th, [role=heading]"},
    "pixel": {"dot": "h1, h2, h3, th, [role=heading]", "code": "code, pre, kbd, samp, tt"},
}


def fonts_style():
    """Usercss «Nihil fonts» на все сайты. У stock правил нет, но стиль остаётся (пустым), а не
    заглушкой: у заглушки версия 0.0.0, и Stylus отказался бы ставить её поверх 1.0.x."""
    cfg = load_json(FONTS_JSON, {})
    profile = cfg.get("profile") or "stock"
    rules = FONT_RULES.get(profile, {})
    css = []
    if "dot" in rules:
        css.append(f"{rules['dot']} {{ font-family: {DOT} !important; font-weight: 700 !important; letter-spacing: 0.03em; }}")
    if "code" in rules:
        css.append(f'{rules["code"]} {{ font-family: "{cfg.get("mono", "monospace")}", monospace !important; }}')
    name = "nihil-fonts"
    url = style_url(name)
    # Комментарий без правил Stylus счёл бы пустым стилем — для stock одна безвредная переменная.
    body = "\n  ".join(css) or "html { --omarchy-font-profile: stock; }"
    # Stylus ставит обновление, только если версия выросла: новая версия — при каждом
    # изменении правил, иначе прежняя (иначе каждая сборка давала бы «новый» стиль).
    path = WWW / f"{name}.user.css"
    old = path.read_text() if path.is_file() else ""
    m = re.search(r"^@version (\S+)$", old, re.M)
    same = old.endswith(f"{{\n  {body}\n}}\n") and f"({profile})" in old
    version = m.group(1) if m and same and m.group(1) != "1.0.0" else f"1.0.{int(time.time())}"
    code = (f"/* ==UserStyle==\n@name Nihil fonts\n@namespace omarchy\n@version {version}\n"
            f"@description Шрифты по профилю omarchy-font-profile ({profile})\n@updateURL {url}\n"
            f"==/UserStyle== */\n@-moz-document regexp(\".*\") {{\n  {body}\n}}\n")
    style = {
        "name": "Nihil fonts", "enabled": True, "sourceCode": code, "updateUrl": url, "updatable": True,
        "usercssData": {"name": "Nihil fonts", "namespace": "omarchy", "version": version, "updateURL": url},
        "sections": [{"code": body, "regexps": [".*"]}],
        "originalDigest": hashlib.sha1(code.encode()).hexdigest(),
    }
    return name, code, style


def build():
    pal = palette(THEME_DIR / "colors.toml")
    block = override_block(pal, filters(pal))
    lib = LIB.read_text().rstrip("\n")
    backup = json.loads(TEMPLATE.read_text())

    WWW.mkdir(parents=True, exist_ok=True)
    styles, used, skipped = [], {}, []
    for item in backup:
        if not isinstance(item, dict) or not isinstance(item.get("sourceCode"), str):
            continue
        code = item["sourceCode"]
        m = RX_LIB.search(code)
        if not m:
            skipped.append(item.get("name"))
            continue
        name = slug(item.get("name", ""))
        while name in used:
            name += "-1"
        url = style_url(name)
        code = code[:m.start()] + lib + "\n" + block + code[m.end():]
        code = set_update_url(code, url)
        write_atomic(WWW / f"{name}.user.css", code)
        used[name] = item.get("name", name)

        style = copy.deepcopy(item)
        style.update(sourceCode=code, updateUrl=url, updatable=True, enabled=True)
        style.setdefault("usercssData", {})["updateURL"] = url
        for key in ("originalMd5", "etag", "id"):
            style.pop(key, None)
        # Stylus считает usercss неизменённым, если originalDigest = SHA-1 исходника;
        # без него стиль помечается «may be locally edited» и не обновляется.
        style["originalDigest"] = hashlib.sha1(code.encode()).hexdigest()
        styles.append(style)

    name, code, style = fonts_style()
    write_atomic(WWW / f"{name}.user.css", code)
    used[name] = "Nihil fonts"
    styles.append(style)

    # Стили из прошлых наборов, которых сейчас нет: пустая заглушка вместо кода.
    served = load_json(SERVED, None)
    if served is None:  # первый запуск: всё, что уже лежит в www, отдавалось раньше
        served = {p.name[:-len(".user.css")]: p.name[:-len(".user.css")] for p in WWW.glob("*.user.css")}
    for name in sorted(set(served) - set(used)):
        write_atomic(WWW / f"{name}.user.css", stub(served[name], style_url(name)))
    served.update(used)
    write_atomic(SERVED, json.dumps(served, indent=1, ensure_ascii=False) + "\n")

    settings = dict(backup[0].get("settings", {})) if backup and "settings" in backup[0] else {}
    settings["updateInterval"] = UPDATE_INTERVAL_HOURS
    imp = [{"settings": settings}] + styles
    write_atomic(WWW / "import.json", json.dumps(imp, ensure_ascii=False) + "\n")
    digest = hashlib.sha256("".join(s["sourceCode"] for s in styles).encode()).hexdigest()[:16]
    write_atomic(BUILD, json.dumps({"digest": digest}) + "\n")
    stubs = len(set(served) - set(used))
    theme = (THEME_DIR.parent / "theme.name").read_text().strip() if (THEME_DIR.parent / "theme.name").is_file() else "?"
    log(f"тема '{theme}': {len(styles)} стилей, заглушек {stubs}"
        + (f", без библиотеки Catppuccin (пропущены): {skipped}" if skipped else ""))


BROWSER_PROCS = {"helium": ["helium"], "firefox": ["firefox", "firefox-bin"]}
FIREFOX_ROOT = HOME / ".config/mozilla/firefox"
FIREFOX_STYLUS_ID = "{7a7a4a92-a2a0-41d1-9fd7-1e92480d612d}"


def running(browser):
    import subprocess
    for proc in BROWSER_PROCS[browser]:
        r = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", proc],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if r.returncode == 0:
            return True
    return False


def helium_running():
    return running("helium")


def prime_helium():
    import plyvel  # из пакета python-plyvel
    try:
        db = plyvel.DB(str(HELIUM_STYLUS_STORE), create_if_missing=False)
    except plyvel.Error as e:
        log(f"prime helium: хранилище Stylus недоступно ({e})")
        return False
    try:
        db.put(b"lastUpdateTime", b"1")
    finally:
        db.close()
    return True


def firefox_profile():
    import configparser
    ini = configparser.ConfigParser()
    if not ini.read(FIREFOX_ROOT / "profiles.ini"):
        return None
    for sec in ini.sections():
        if sec.startswith("Install") and ini[sec].get("Default"):
            return FIREFOX_ROOT / ini[sec]["Default"]
    return None


def idb_key(text):
    """Ключ-строка IndexedDB Firefox: 0x30 + символы, сдвинутые на +1 (ASCII)."""
    return b"0" + bytes(ord(c) + 1 for c in text)


def sc_double(value):
    """Число в формате structured clone SpiderMonkey, сжатое snappy одним литералом
    (литерал — допустимый snappy-поток без сжатия, библиотека не нужна)."""
    import struct
    raw = bytes.fromhex("030000000000f1ff") + struct.pack("<d", value)
    return bytes([len(raw), (len(raw) - 1) << 2]) + raw


def prime_firefox():
    """storage.local Stylus в Firefox — IndexedDB webExtensions-storage-local в профиле."""
    import re
    import sqlite3
    profile = firefox_profile()
    if not profile:
        return True
    m = re.search(re.escape(FIREFOX_STYLUS_ID) + r'\\?":\\?"([0-9a-f-]{36})', (profile / "prefs.js").read_text())
    if not m:
        log("prime firefox: Stylus не установлен, пропуск")
        return True
    idb = profile / "storage/default" / f"moz-extension+++{m.group(1)}^userContextId=4294967295" / "idb"
    for db_path in idb.glob("*.sqlite"):
        try:
            with sqlite3.connect(db_path, timeout=5) as con:
                if con.execute("SELECT name FROM database").fetchone()[0] != "webExtensions-storage-local":
                    continue
                n = con.execute("UPDATE object_data SET data = ? WHERE key = ?",
                                (sc_double(1.0), idb_key("lastUpdateTime"))).rowcount
        except sqlite3.Error as e:
            log(f"prime firefox: база занята ({e})")
            return False
        if not n:
            log("prime firefox: lastUpdateTime не найден — Stylus ещё ни разу не проверял обновления")
        return True
    log("prime firefox: хранилище storage.local Stylus не найдено")
    return True


def stylus_js(xpi):
    """worker.js и less.js того Stylus, что стоит в Firefox: распаковка из XPI в кэш по версии."""
    import zipfile
    with zipfile.ZipFile(xpi) as z:
        version = json.loads(z.read("manifest.json"))["version"]
        out = STATE / "stylus-js" / version
        if not (out / "js/worker.js").is_file():
            for name in ("worker.js", "less.js", "parserlib.js", "stylus-lang.js"):
                target = out / "js" / name
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(z.read(f"js/{name}"))
    return out


def install_firefox():
    """Новые стили сразу в базу Stylus (IndexedDB «stylish»), пока Firefox закрыт: при запуске
    они уже действуют, без минутного ожидания проверки обновлений. Код собирается тем же
    worker.js/less.js, что внутри Stylus (stylus-compile.cjs через node). Если не вышло —
    запасной путь prime_firefox (Stylus проверит обновления через минуту после запуска)."""
    import shutil
    import subprocess
    from urllib.parse import urlparse
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    import firefox_idb as fi

    profile = firefox_profile()
    if not profile:
        return True
    m = re.search(re.escape(FIREFOX_STYLUS_ID) + r'\\?":\\?"([0-9a-f-]{36})', (profile / "prefs.js").read_text())
    xpi = profile / "extensions" / f"{FIREFOX_STYLUS_ID}.xpi"
    if not m or not xpi.is_file():
        log("install firefox: Stylus не установлен, пропуск")
        return True
    idb = profile / "storage/default" / f"moz-extension+++{m.group(1)}" / "idb"
    con = fi.open_db(idb, "stylish") if idb.is_dir() else None
    if not con:
        log("install firefox: база стилей Stylus не найдена")
        return prime_firefox() and None
    files_dir = fi.files_dir(con)
    try:
        rows = con.execute("SELECT key, data, file_ids FROM object_data WHERE object_store_id = 1").fetchall()
        styles = {key: fi.read_value(data, fids, files_dir) for key, data, fids in rows}
    except Exception as e:
        con.close()
        log(f"install firefox: база не прочитана ({e})")
        return prime_firefox() and None

    jobs = {}
    for key, style in styles.items():
        url = style.get("updateUrl") or ""
        if not url.startswith("http://127.0.0.1:"):
            continue
        src = WWW / Path(urlparse(url).path).name
        code = src.read_text() if src.is_file() else None
        if code and code != style.get("sourceCode"):
            jobs[key] = code
    if not jobs:
        con.close()
        return True

    lines = "".join(json.dumps({"id": i, "code": code, "vars": styles[key].get("usercssData", {}).get("vars")}) + "\n"
                    for i, (key, code) in enumerate(jobs.items()))
    try:
        r = subprocess.run(["node", str(Path(__file__).resolve().parent / "stylus-compile.cjs"), str(stylus_js(xpi))],
                           input=lines, capture_output=True, text=True, timeout=300)
        built = {j["id"]: j for j in map(json.loads, r.stdout.splitlines())}
    except (OSError, subprocess.SubprocessError, ValueError) as e:
        con.close()
        log(f"install firefox: сборка не удалась ({e})")
        return prime_firefox() and None

    backup = STATE / "backups" / f"{time.strftime('%Y%m%d-%H%M%S')}-firefox-idb"
    shutil.copytree(idb, backup)
    now = float(int(time.time() * 1000))
    done, failed = 0, []
    with con:
        for i, (key, code) in enumerate(jobs.items()):
            res, style = built.get(i, {}), styles[key]
            if "sections" not in res or not res["sections"]:
                failed.append(f"{style.get('name')}: {res.get('error', 'пусто')}")
                continue
            meta = res["meta"]
            style.update(sourceCode=code, usercssData=meta, sections=res["sections"],
                         originalDigest=hashlib.sha1(code.encode()).hexdigest(), updateDate=now, _rev=now)
            # Как GLOBAL_META в Stylus: эти поля стиля берутся из метаданных.
            for k, target in (("author", "author"), ("description", "description"), ("homepageURL", "url"),
                              ("updateURL", "updateUrl"), ("name", "name")):
                if meta.get(k) is not None:
                    style[target] = meta[k]
            con.execute("UPDATE object_data SET data = ?, file_ids = NULL WHERE object_store_id = 1 AND key = ?",
                        (fi.snap(fi.encode(style)), key))
            done += 1
        fi.flush_refcounts(con)
    con.close()
    log(f"install firefox: записано {done} стилей" + (f", не собраны: {failed}" if failed else ""))
    if failed:
        prime_firefox()  # остальные Stylus подтянет сам через минуту после запуска
        return None
    return True


PRIMERS = {"helium": prime_helium, "firefox": install_firefox}

# --- Helium: проверка обновлений сразу при запуске через CDP по pipe ---------
# Обёртка helium-browser запускает Helium через `omarchy-stylus helium-launch`. Если набор
# стилей изменился с прошлого применения, Helium стартует с --remote-debugging-pipe: канал
# управления — только пара pipe у этого процесса, порт не открывается. Через него в service
# worker Stylus вызывается API.updater.checkAllStyles(), и Stylus за секунды сам забирает
# стили с локального сервера. Закрытие pipe завершает Chromium, поэтому процесс остаётся
# родителем Helium до его выхода (спит на чтении pipe).

HELIUM_BIN = "/usr/bin/helium-browser"
HELIUM_STYLUS_ID = "clngdbkpkpeebahjckkjfobafhncgmne"


class _Pipe:
    def __init__(self, rfd, wfd):
        import queue
        import threading
        self.rfd, self.wfd, self.inbox, self.n = rfd, wfd, queue.Queue(), 0
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self):
        buf = b""
        while True:
            chunk = os.read(self.rfd, 65536)
            if not chunk:
                self.inbox.put(None)
                return
            buf += chunk
            while b"\0" in buf:
                msg, buf = buf.split(b"\0", 1)
                try:
                    self.inbox.put(json.loads(msg))
                except ValueError:
                    pass

    def send(self, method, params=None, session=None):
        self.n += 1
        msg = {"id": self.n, "method": method, "params": params or {}}
        if session:
            msg["sessionId"] = session
        os.write(self.wfd, json.dumps(msg).encode() + b"\0")
        return self.n

    def wait(self, pred, timeout):
        import queue
        end = time.time() + timeout
        while time.time() < end:
            try:
                msg = self.inbox.get(timeout=0.5)
            except queue.Empty:
                continue
            if msg is None:
                return None
            if pred(msg):
                return msg
        return None

    def call(self, method, params=None, session=None, timeout=15):
        i = self.send(method, params, session)
        return self.wait(lambda m: m.get("id") == i, timeout)


def _stylus_check(cdp):
    """Дождаться service worker Stylus и выполнить проверку обновлений. True — успешно."""
    def is_sw(m):
        info = m.get("params", {}).get("targetInfo", {})
        return (m.get("method") in ("Target.targetCreated", "Target.targetInfoChanged")
                and info.get("type") == "service_worker" and HELIUM_STYLUS_ID in info.get("url", ""))
    cdp.send("Target.setDiscoverTargets", {"discover": True})
    sw, waker = cdp.wait(is_sw, 5), None
    if not sw:
        # Воркер спит: будит его скрытая (без вкладки) страница расширения.
        r = cdp.call("Target.createTarget", {"url": f"chrome-extension://{HELIUM_STYLUS_ID}/options.html",
                                             "hidden": True, "background": True})
        waker = r and r.get("result", {}).get("targetId")
        sw = cdp.wait(is_sw, 30)
    try:
        if not sw:
            log("helium: service worker Stylus не появился")
            return False
        att = cdp.call("Target.attachToTarget", {"targetId": sw["params"]["targetInfo"]["targetId"], "flatten": True})
        sid = att and att.get("result", {}).get("sessionId")
        if not sid:
            return False
        for _ in range(60):  # API появляется после инициализации воркера
            r = cdp.call("Runtime.evaluate", {"expression": "typeof self.API?.updater?.checkAllStyles",
                                              "returnByValue": True}, sid)
            if r and r.get("result", {}).get("result", {}).get("value") == "function":
                break
            time.sleep(0.5)
        r = cdp.call("Runtime.evaluate", {"expression": "API.updater.checkAllStyles().then(() => 'done')",
                                          "awaitPromise": True, "returnByValue": True}, sid, timeout=300)
        ok = bool(r) and r.get("result", {}).get("result", {}).get("value") == "done"
        cdp.call("Target.detachFromTarget", {"sessionId": sid})
        return ok
    finally:
        if waker:
            cdp.call("Target.closeTarget", {"targetId": waker})
        cdp.send("Target.setDiscoverTargets", {"discover": False})


def helium_launch(args):
    import subprocess
    build = load_json(BUILD, {}).get("digest")
    applied = load_json(PRIMED, {}).get("helium-cdp")
    if running("helium") or not build or build == applied:
        os.execv(HELIUM_BIN, [HELIUM_BIN, *args])

    r3, w3 = os.pipe()  # Helium читает команды из fd 3
    r4, w4 = os.pipe()  # и пишет ответы в fd 4

    def fds():
        a, b = os.dup(r3), os.dup(w4)
        os.dup2(a, 3)
        os.dup2(b, 4)

    proc = subprocess.Popen([HELIUM_BIN, "--remote-debugging-pipe", *args], preexec_fn=fds, pass_fds=(3, 4))
    os.close(r3)
    os.close(w4)
    cdp = _Pipe(r4, w3)
    t0 = time.time()
    try:
        ok = _stylus_check(cdp)
    except Exception as e:  # Helium уже запущен — второй запуск из fallback не нужен
        ok = False
        log(f"helium: CDP ({e!r})")
    if ok:
        primed = load_json(PRIMED, {})
        primed["helium-cdp"] = build
        write_atomic(PRIMED, json.dumps(primed) + "\n")
        log(f"helium: Stylus обновил стили при запуске ({time.time() - t0:.0f} с)")
    else:
        log("helium: проверка через CDP не удалась — повторится при следующем запуске")
    # Дальше только вычитываем pipe (событий нет) и ждём выхода Helium.
    sys.exit(proc.wait())


def prime_one(browser):
    """Если набор стилей изменился с прошлого раза, просит Stylus этого браузера проверить
    обновления сразу после старта: lastUpdateTime = 1 мс от эпохи, и Stylus ставит проверку
    через минуту (MIN_INTERVAL_MS). Только пока браузер закрыт: "done" | "running" | "failed"."""
    build = load_json(BUILD, {}).get("digest")
    primed = load_json(PRIMED, {})
    if "digest" in primed:  # старый формат: одна отметка для Helium
        primed = {"helium": primed["digest"]}
    # Firefox: отметка о записи стилей прямо в базу (старая «firefox» значила только prime).
    key = {"firefox": "firefox-db"}.get(browser, browser)
    if not build or primed.get(key) == build:
        return "done"
    if running(browser):
        return "running"
    res = PRIMERS[browser]()
    if res is False:
        return "failed"
    if res is None:  # сработал только запасной prime — при следующем закрытии попробовать снова
        return "done"
    primed[key] = build
    write_atomic(PRIMED, json.dumps(primed) + "\n")
    if browser == "helium":
        log("prime helium: Stylus проверит обновления через минуту после запуска")
    return "done"


def prime(browsers=None):
    for browser in browsers or PRIMERS:
        prime_one(browser)


def spawn_waiter(browser):
    import subprocess
    subprocess.Popen(["/usr/bin/python3", "-I", os.path.abspath(__file__), "wait", browser],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def wait(browser):
    """Ждёт закрытия браузера и делает prime — тема, сменённая при открытом браузере,
    доходит до Stylus при следующем запуске без обёртки."""
    import fcntl
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / f"wait-{browser}.lock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        while True:
            while running(browser):
                time.sleep(1)
            for _ in range(15):
                state = prime_one(browser)
                if state in ("done", "running"):
                    break
                time.sleep(2)  # база ещё может быть заблокирована
            if state != "running":
                return


def sync():
    build()
    for browser in PRIMERS:
        if prime_one(browser) == "running":
            spawn_waiter(browser)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "sync"
    if cmd == "sync":
        sync()
    elif cmd == "prime":
        prime(argv[2:] or None)
    elif cmd == "helium-launch":
        try:
            helium_launch(argv[2:])
        except Exception as e:  # браузер должен запуститься в любом случае
            log(f"helium-launch: {e!r}")
            os.execv(HELIUM_BIN, [HELIUM_BIN, *argv[2:]])
    elif cmd == "wait" and len(argv) == 3 and argv[2] in PRIMERS:
        wait(argv[2])
    elif cmd == "palette":
        path = Path(argv[2]) if len(argv) > 2 else THEME_DIR / "colors.toml"
        print(json.dumps(palette(path), indent=2))
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
