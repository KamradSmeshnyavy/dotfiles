#!/usr/bin/env python3
"""
Генерирует файл ~/.config/tmux/om-theme.conf с tmux-переменными @om_*
(номера ANSI — их палитру задаёт тема Omarchy в терминале).
"""
import sys, os

OUTPUT     = os.path.expanduser("~/.config/tmux/om-theme.conf")

# Терминал уже раскрашен палитрой темы Omarchy, поэтому семантические цвета —
# это просто номера ANSI. (Раньше hex подбирался к стандартной палитре xterm,
# и red/green/yellow у многих тем превращались в colour7.)
ANSI = {
    "bg": "colour0", "fg": "default",
    "red": "colour1", "green": "colour2", "yellow": "colour3", "blue": "colour4",
    "magenta": "colour5", "cyan": "colour6", "white": "colour7", "black": "colour0",
    "overlay0": "colour8", "overlay1": "colour15",
    "rosewater": "colour15", "lavender": "colour12", "maroon": "colour9",
}

def generate_tmux_vars():
    return "\n".join(f'set -g @om_{name} "{colour}"' for name, colour in ANSI.items())

if __name__ == "__main__":
    try:
        conf = generate_tmux_vars()
        with open(OUTPUT, "w") as f:
            f.write(conf + "\n")
        print(f"✅ {OUTPUT} обновлён.")
    except Exception as e:
        sys.exit(f"Ошибка: {e}")
