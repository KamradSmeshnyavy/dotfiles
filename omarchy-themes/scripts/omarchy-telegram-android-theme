#!/usr/bin/env python3
"""
Тема Telegram для Android (.attheme) из colors.toml темы Omarchy.

Использование:
  omarchy-telegram-android-theme <каталог темы> <выходной .attheme>
  omarchy-telegram-android-theme --update-palette   # перекачать список ключей из DrKLO/Telegram

.attheme — строки «ключ=#AARRGGBB»; имя темы в Telegram — имя файла. Тёмная тема или светлая, Telegram
решает сам по яркости windowBackgroundWhite. Ключи с цветом по умолчанию (data/telegram-android-palette.tsv)
пересчитываются как на desktop (telegram_common.remap), основные заданы явно. Звонки и всплывашки
(тёмные по замыслу) не трогаются.
"""
import re
import sys
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from telegram_common import remap, split_alpha  # noqa: E402
from theme_palette import Palette, contrast, hls, mix  # noqa: E402

DATA = Path(__file__).resolve().parent / "data" / "telegram-android-palette.tsv"
SOURCE = (
    "https://raw.githubusercontent.com/DrKLO/Telegram/master/"
    "TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ThemeColors.java"
)
KEEP = ("voipgroup_", "calls_", "returnToCall", "undo_", "key_")


def java_color(expr, consts):
    """Значение из defaultColors[…] = expr → '#rrggbb' или '#rrggbbaa' (None — не цвет)."""
    expr = expr.strip()
    if expr in consts:
        return consts[expr]
    m = re.fullmatch(r"ColorUtils\.setAlphaComponent\((.+),\s*(\d+)\)", expr)
    if m:
        base = java_color(m.group(1), consts)
        return base and split_alpha(base)[0] + f"{int(m.group(2)):02x}"
    if expr == "Color.WHITE":
        v = 0xFFFFFFFF
    elif expr == "Color.BLACK":
        v = 0xFF000000
    elif re.fullmatch(r"0[xX][0-9a-fA-F]{8}", expr):
        v = int(expr, 16)
    elif re.fullmatch(r"-?\d+", expr) and expr != "0":
        v = int(expr) & 0xFFFFFFFF
    else:
        return None
    a, rgb = v >> 24, v & 0xFFFFFF
    return f"#{rgb:06x}" + ("" if a == 0xFF else f"{a:02x}")


def update_palette():
    with urllib.request.urlopen(SOURCE, timeout=60) as r:
        text = r.read().decode()
    consts = {}
    for name, value in re.findall(r"static final int (\w+) = (0[xX][0-9a-fA-F]{8});", text):
        consts[name] = java_color(value, {})
    defaults = dict(re.findall(r"defaultColors\[key_(\w+)\] = ([^;]+);", text))
    names = re.findall(r'colorKeysMap\.put\(key_(\w+), "([^"]+)"\)', text)
    if len(names) < 500:
        sys.exit(f"omarchy-telegram-android-theme: в {SOURCE} нашлось только {len(names)} ключей")
    rows = []
    for ident, name in names:
        value = java_color(defaults[ident], consts) if ident in defaults else None
        rows.append(f"{name}\t{value or ''}\n")
    header = (
        "# Ключи палитры Telegram Android (имя в .attheme) и значения светлой темы по умолчанию;\n"
        "# пусто — у ключа нет своего значения (Telegram выводит его из другого).\n"
        f"# Источник: {SOURCE}\n# Обновить: omarchy-telegram-android-theme --update-palette\n"
    )
    DATA.write_text(header + "".join(rows), encoding="utf-8")
    print(f"{DATA}: {len(rows)} ключей")


def keys():
    for line in DATA.read_text(encoding="utf-8").splitlines():
        if line and not line.startswith("#"):
            key, value = line.split("\t")
            yield key, value


