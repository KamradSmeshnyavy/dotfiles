    c = {
        # окна, списки, настройки
        "windowBackgroundWhite": p.bg,
        "windowBackgroundGray": p.bg_dark,
        "windowBackgroundWhiteBlackText": p.fg,
        "windowBackgroundWhiteGrayIcon": p.fg_muted,
        "windowBackgroundWhiteHintText": p.fg_muted,
        "windowBackgroundWhiteInputField": p.overlay,
        "windowBackgroundWhiteInputFieldActivated": p.accent,
        "windowBackgroundChecked": p.accent,
        "windowBackgroundUnchecked": p.muted,
        "windowBackgroundCheckText": on,
        "listSelectorSDK21": hover,
        "divider": p.overlay,
        "graySection": p.bg_dark,
        "dialogBackground": p.surface,
        "dialogBackgroundGray": p.bg_dark,
        "dialogTextBlack": p.fg,
