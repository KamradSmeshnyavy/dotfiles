    for suffix, value in bar.items():
        c["actionBarDefault" + suffix] = value
        c["actionBarDefaultArchived" + suffix] = value
    return c


# вторичный текст: у некоторых тем (nord) dark_foreground почти сливается с фоном — подтянуть к тексту
READABLE = {
    "chats_message": "windowBackgroundWhite",
    "chats_message_threeLines": "windowBackgroundWhite",
    "chats_date": "windowBackgroundWhite",
    "windowBackgroundWhiteGrayText": "windowBackgroundWhite",
    "windowBackgroundWhiteGrayText2": "windowBackgroundWhite",
    "windowBackgroundWhiteHintText": "windowBackgroundWhite",
    "actionBarDefaultSubtitle": "actionBarDefault",
    "chat_inTimeText": "chat_inBubble",
    "chat_outTimeText": "chat_outBubble",
    "chat_messagePanelHint": "chat_messagePanelBackground",
}


def readable(p, color, bg, target=4.5):
    """color, сдвинутый к яркому тексту, пока контраст с bg не станет ≥ target."""
    for i in range(11):
        c = mix(color, p.fg_bright, i / 10)
        if contrast(c, bg) >= target:
            return c
    return p.fg_bright


def recolor(p, key, value):
    """Ключ без явного значения: перекраска как на desktop + поправки под Android."""
    base, alpha = split_alpha(value)
    _, l, s = hls(base)
    if "Shadow" in key:  # тени остаются тенями
        return value
    if alpha and s < 0.15 and l < 0.5 and p.dark and int(alpha, 16) < 0x60:
        # тёмная дымка поверх светлого (наведение, нажатие) → светлая дымка поверх тёмного
        return p.fg_bright + alpha
    if not alpha and base == "#ffffff" and re.search(r"(Text|Icon|Check|Counter|Name|Phone)$", key, re.I):
        # белое поверх цветной плашки
        return p.on_accent
    return remap(p, value, outgoing=key.startswith("chat_out"))


def argb(value):
    """'#rrggbb[aa]' → '#AARRGGBB' (формат Android)."""
    base, alpha = split_alpha(value)
    return f"#{(alpha or 'ff')}{base[1:]}".upper()


def build(theme_dir, out):
    p = Palette(theme_dir)
    explicit = palette(p)
    colors = {}
    for key, value in keys():
        if key in explicit:
            colors[key] = explicit[key]
        elif value and not key.startswith(KEEP):
            colors[key] = recolor(p, key, value)
    for key, bg in READABLE.items():
        colors[key] = readable(p, colors[key], colors[bg])
    lines = [f"{key}={argb(value)}" for key, value in colors.items()]
    Path(out).write_text("\n".join(lines) + "\n", encoding="utf-8")


if __name__ == "__main__":
    if sys.argv[1:] == ["--update-palette"]:
        update_palette()
    elif len(sys.argv) == 3:
        build(Path(sys.argv[1]), sys.argv[2])
    else:
        sys.exit(__doc__)
