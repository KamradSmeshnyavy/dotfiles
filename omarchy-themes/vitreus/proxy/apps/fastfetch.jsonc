// Vitreus: omarchy-themes/vitreus/build.py по палитре темы
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/apps/vitreus-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;255;240;122",
      "title": "38;2;255;210;31",
      "output": "38;2;242;246;248",
      "separator": "38;2;42;50;59"
    },
    "key": {
      "width": 8
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 12,
      "border": {
        "left": "",
        "right": ""
      }
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;255;210;31",
        "yellow": "38;2;255;240;122",
        "red": "38;2;255;77;109"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;255;210;31mVITREUS \u001b[38;2;147;161;172m// \u001b[38;2;242;246;248mproxy"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;42;50;59m──────────────────────────────"
    },
    {
      "type": "title",
      "key": "host",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "os",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "term",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;16;22;29m   \u001b[48;2;18;25;32m   \u001b[48;2;42;50;59m   \u001b[48;2;42;140;255m   \u001b[48;2;217;164;0m   \u001b[48;2;255;210;31m   \u001b[48;2;255;240;122m   \u001b[48;2;255;77;109m   \u001b[48;2;147;161;172m   \u001b[48;2;242;246;248m   \u001b[0m"
    }
  ]
}
