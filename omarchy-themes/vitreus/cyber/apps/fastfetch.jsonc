// Vitreus: omarchy-themes/vitreus/build.py по палитре темы
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/apps/vitreus-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;125;243;255",
      "title": "38;2;0;229;255",
      "output": "38;2;214;247;255",
      "separator": "38;2;38;56;74"
    },
    "key": {
      "width": 8
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 12,
      "border": {
        "left": "",
        "right": ""
      }
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;0;229;255",
        "yellow": "38;2;125;243;255",
        "red": "38;2;255;59;92"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;0;229;255mVITREUS \u001b[38;2;111;147;168m// \u001b[38;2;214;247;255mcyber"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;38;56;74m──────────────────────────────"
    },
    {
      "type": "title",
      "key": "host",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "os",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "term",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;4;7;13m   \u001b[48;2;10;18;32m   \u001b[48;2;38;56;74m   \u001b[48;2;255;43;214m   \u001b[48;2;0;169;196m   \u001b[48;2;0;229;255m   \u001b[48;2;125;243;255m   \u001b[48;2;255;59;92m   \u001b[48;2;111;147;168m   \u001b[48;2;214;247;255m   \u001b[0m"
    }
  ]
}
