// Vitreus: omarchy-themes/vitreus/build.py по палитре темы
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/apps/vitreus-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;79;118;176",
      "title": "38;2;106;144;201",
      "output": "38;2;59;54;49",
      "separator": "38;2;217;203;174"
    },
    "key": {
      "width": 8
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 12,
      "border": {
        "left": "",
        "right": ""
      }
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;106;144;201",
        "yellow": "38;2;79;118;176",
        "red": "38;2;217;89;79"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;106;144;201mVITREUS \u001b[38;2;133;123;108m// \u001b[38;2;59;54;49mpaper"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;217;203;174m──────────────────────────────"
    },
    {
      "type": "title",
      "key": "host",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "os",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "term",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;239;228;205m   \u001b[48;2;246;238;221m   \u001b[48;2;217;203;174m   \u001b[48;2;90;77;61m   \u001b[48;2;79;118;176m   \u001b[48;2;106;144;201m   \u001b[48;2;169;193;230m   \u001b[48;2;217;89;79m   \u001b[48;2;133;123;108m   \u001b[48;2;59;54;49m   \u001b[0m"
    }
  ]
}
