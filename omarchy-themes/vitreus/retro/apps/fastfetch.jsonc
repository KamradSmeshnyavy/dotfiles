// Vitreus: omarchy-themes/vitreus/build.py по палитре темы
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/apps/vitreus-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;168;36;43",
      "title": "38;2;230;58;58",
      "output": "38;2;43;40;51",
      "separator": "38;2;163;158;142"
    },
    "key": {
      "width": 8
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 12,
      "border": {
        "left": "",
        "right": ""
      }
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;230;58;58",
        "yellow": "38;2;168;36;43",
        "red": "38;2;216;27;96"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;230;58;58mVITREUS \u001b[38;2;106;102;90m// \u001b[38;2;43;40;51mretro"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;163;158;142m──────────────────────────────"
    },
    {
      "type": "title",
      "key": "host",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "os",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "term",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;214;208;189m   \u001b[48;2;191;185;165m   \u001b[48;2;163;158;142m   \u001b[48;2;43;40;51m   \u001b[48;2;168;36;43m   \u001b[48;2;230;58;58m   \u001b[48;2;255;123;92m   \u001b[48;2;216;27;96m   \u001b[48;2;106;102;90m   \u001b[48;2;43;40;51m   \u001b[0m"
    }
  ]
}
