// Vitreus: omarchy-themes/vitreus/build.py по палитре темы
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/apps/vitreus-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;194;47;99",
      "title": "38;2;224;69;123",
      "output": "38;2;34;32;46",
      "separator": "38;2;235;227;210"
    },
    "key": {
      "width": 8
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 12,
      "border": {
        "left": "",
        "right": ""
      }
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;224;69;123",
        "yellow": "38;2;194;47;99",
        "red": "38;2;229;72;77"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;224;69;123mVITREUS \u001b[38;2;107;101;119m// \u001b[38;2;34;32;46mdoodle"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;235;227;210m──────────────────────────────"
    },
    {
      "type": "title",
      "key": "host",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "os",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "term",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;251;245;232m   \u001b[48;2;255;253;246m   \u001b[48;2;235;227;210m   \u001b[48;2;252;211;77m   \u001b[48;2;194;47;99m   \u001b[48;2;224;69;123m   \u001b[48;2;247;168;196m   \u001b[48;2;229;72;77m   \u001b[48;2;107;101;119m   \u001b[48;2;34;32;46m   \u001b[0m"
    }
  ]
}
