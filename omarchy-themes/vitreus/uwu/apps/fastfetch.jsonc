// Vitreus: omarchy-themes/vitreus/build.py по палитре темы
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/apps/vitreus-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;214;31;124",
      "title": "38;2;255;61;154",
      "output": "38;2;58;42;140",
      "separator": "38;2;207;198;242"
    },
    "key": {
      "width": 8
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 12,
      "border": {
        "left": "",
        "right": ""
      }
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;255;61;154",
        "yellow": "38;2;214;31;124",
        "red": "38;2;255;61;110"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;255;61;154mVITREUS \u001b[38;2;122;106;208m// \u001b[38;2;58;42;140muwu"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;207;198;242m──────────────────────────────"
    },
    {
      "type": "title",
      "key": "host",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "os",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "term",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;233;226;255m   \u001b[48;2;212;200;255m   \u001b[48;2;207;198;242m   \u001b[48;2;39;26;94m   \u001b[48;2;214;31;124m   \u001b[48;2;255;61;154m   \u001b[48;2;255;124;192m   \u001b[48;2;255;61;110m   \u001b[48;2;122;106;208m   \u001b[48;2;58;42;140m   \u001b[0m"
    }
  ]
}
