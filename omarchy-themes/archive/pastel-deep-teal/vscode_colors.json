        "statusBar.noFolderBackground": "#152836",
        "statusBar.noFolderForeground": "#d6e4ec",
        "statusBarItem.activeBackground": "#152836",
        "statusBarItem.hoverBackground": "#152836",
        "statusBarItem.remoteBackground": "#6bb5a7",
        "statusBarItem.remoteForeground": "#0d1820",

        "titleBar.activeBackground": "#0d1820",
        "titleBar.activeForeground": "#d6e4ec",
