        "settings.modifiedItemIndicator": "#4a9eb5",
        "settings.dropdownBackground": "#152836",
        "settings.dropdownForeground": "#d6e4ec",
        "settings.checkboxBackground": "#152836",
        "settings.checkboxForeground": "#d6e4ec",
        "settings.textInputBackground": "#152836",
        "settings.textInputForeground": "#d6e4ec",
        "settings.numberInputBackground": "#152836",
        "settings.numberInputForeground": "#d6e4ec",

        "breadcrumb.foreground": "#d6e4ec",
        "breadcrumb.background": "#0d1820",
        "breadcrumb.focusForeground": "#ffffff",
        "breadcrumbPicker.background": "#0d1820",

        "notebook.editorBackground": "#0d1820",
        "notebook.cellBorderColor": "#152836",
        "notebook.cellHoverBackground": "#152836",
        "notebook.focusedCellBorder": "#4a9eb5",
        "notebook.selectedCellBackground": "#152836",

        "charts.foreground": "#d6e4ec",
        "charts.lines": "#d6e4ec",
        "charts.red": "#d48a8a",
        "charts.blue": "#4a9eb5",
        "charts.yellow": "#d4b88a",
        "charts.green": "#6bb5a7",
        "charts.purple": "#9a8ad4"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#507080" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.parameter"],
            "settings": { "foreground": "#d48a8a" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.modifier", "keyword.control"],
            "settings": { "foreground": "#6bb5a7" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "meta.function-call", "support.function"],
            "settings": { "foreground": "#4a9eb5" }
        },
        {
            "name": "String",
            "scope": ["string"],
            "settings": { "foreground": "#6bb5a7" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#9a8ad4" }
        },
        {
            "name": "Type",
            "scope": ["entity.name.type", "support.type", "storage.type"],
            "settings": { "foreground": "#d4b88a" }
        },
        {
            "name": "Class",
            "scope": ["entity.name.class", "support.class"],
            "settings": { "foreground": "#d4b88a" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#d48a8a" }
        },
        {
            "name": "Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#4a9eb5" }
        },
        {
            "name": "Constant",
            "scope": ["constant", "support.constant"],
            "settings": { "foreground": "#9a8ad4" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator", "punctuation"],
            "settings": { "foreground": "#9a8ad4" }
        },
        {
            "name": "Embedded",
            "scope": ["punctuation.section.embedded", "variable.interpolation"],
            "settings": { "foreground": "#9a8ad4" }
        },
        {
            "name": "Markup Heading",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#4a9eb5", "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#9a8ad4" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#9a8ad4" }
        },
        {
            "name": "Markup Link",
            "scope": ["string.other.link", "markup.underline"],
            "settings": { "foreground": "#4a9eb5" }
        },
        {
            "name": "Markup List",
            "scope": ["punctuation.definition.list_item"],
            "settings": { "foreground": "#6bb5a7" }
        },
        {
            "name": "Markup Quote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#507080", "fontStyle": "italic" }
        },
        {
            "name": "Markup Raw",
            "scope": ["markup.raw", "markup.inline.raw"],
            "settings": { "foreground": "#9a8ad4" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#4a9eb5" }
        },
        {
            "name": "JSON Key",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#4a9eb5" }
        }
    ]
}
