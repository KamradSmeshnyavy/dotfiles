        "gitDecoration.deletedResourceForeground": "#d48a8a",
        "gitDecoration.untrackedResourceForeground": "#4a9eb5",
        "gitDecoration.ignoredResourceForeground": "#507080",
        "gitDecoration.conflictingResourceForeground": "#9a8ad4",

