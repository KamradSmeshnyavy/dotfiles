        "statusBar.background": "#a8d8b9",
        "statusBar.foreground": "#1a1b2e",
        "statusBar.debuggingBackground": "#f5bde6",
        "statusBar.debuggingForeground": "#1a1b2e",
        "statusBar.noFolderBackground": "#252740",
        "statusBar.noFolderForeground": "#e2dff0",
        "statusBarItem.activeBackground": "#252740",
        "statusBarItem.hoverBackground": "#252740",
        "statusBarItem.remoteBackground": "#89ddff",
        "statusBarItem.remoteForeground": "#1a1b2e",

        "titleBar.activeBackground": "#1a1b2e",
        "titleBar.activeForeground": "#e2dff0",
        "titleBar.inactiveBackground": "#121326",
        "titleBar.inactiveForeground": "#6e6a9e",

        "menubar.selectionForeground": "#e2dff0",
        "menubar.selectionBackground": "#252740",
