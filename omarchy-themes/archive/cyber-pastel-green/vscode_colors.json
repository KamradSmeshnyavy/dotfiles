        "diffEditor.insertedTextBackground": "#a8d8b920",
        "diffEditor.removedTextBackground": "#f2b5b520",

        "editorWidget.background": "#1a1b2e",
        "editorWidget.foreground": "#e2dff0",
        "editorSuggestWidget.background": "#1a1b2e",
        "editorSuggestWidget.foreground": "#e2dff0",
        "editorSuggestWidget.highlightForeground": "#a8d8b9",
        "editorSuggestWidget.selectedBackground": "#252740",
        "editorHoverWidget.background": "#1a1b2e",
        "editorHoverWidget.foreground": "#e2dff0",

        "panel.background": "#1a1b2e",
