        "editorBracketHighlight.foreground3": "#f5bde6",
        "editorBracketHighlight.foreground4": "#c9b5f5",
        "editorBracketHighlight.foreground5": "#f5e0b5",
        "editorBracketHighlight.foreground6": "#f2b5b5",

        "editorOverviewRuler.findMatchForeground": "#a8d8b9",
