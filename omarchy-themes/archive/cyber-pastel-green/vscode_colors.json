        "notificationLink.foreground": "#89ddff",

        "commandCenter.foreground": "#e2dff0",
        "commandCenter.activeForeground": "#ffffff",
        "commandCenter.background": "#252740",
        "commandCenter.activeBackground": "#252740",

        "terminal.background": "#1a1b2e",
        "terminal.foreground": "#e2dff0",
        "terminal.ansiBlack": "#121326",
        "terminal.ansiRed": "#f2b5b5",
        "terminal.ansiGreen": "#a8d8b9",
        "terminal.ansiYellow": "#f5e0b5",
        "terminal.ansiBlue": "#89ddff",
        "terminal.ansiMagenta": "#f5bde6",
        "terminal.ansiCyan": "#c9b5f5",
        "terminal.ansiWhite": "#e2dff0",
        "terminal.ansiBrightBlack": "#6e6a9e",
        "terminal.ansiBrightRed": "#f2b5b5",
        "terminal.ansiBrightGreen": "#a8d8b9",
        "terminal.ansiBrightYellow": "#f5e0b5",
        "terminal.ansiBrightBlue": "#89ddff",
        "terminal.ansiBrightMagenta": "#f5bde6",
        "terminal.ansiBrightCyan": "#c9b5f5",
        "terminal.ansiBrightWhite": "#ffffff",
        "terminalCursor.foreground": "#a8d8b9",

        "debugToolBar.background": "#252740",
        "debugIcon.startForeground": "#a8d8b9",
        "debugIcon.pauseForeground": "#89ddff",
        "debugIcon.stopForeground": "#f2b5b5",
        "debugIcon.restartForeground": "#a8d8b9",

        "gitDecoration.addedResourceForeground": "#a8d8b9",
        "gitDecoration.modifiedResourceForeground": "#f5e0b5",
        "gitDecoration.deletedResourceForeground": "#f2b5b5",
        "gitDecoration.untrackedResourceForeground": "#89ddff",
        "gitDecoration.ignoredResourceForeground": "#6e6a9e",
        "gitDecoration.conflictingResourceForeground": "#f5bde6",

        "settings.headerForeground": "#e2dff0",
        "settings.modifiedItemIndicator": "#a8d8b9",
        "settings.dropdownBackground": "#252740",
        "settings.dropdownForeground": "#e2dff0",
        "settings.checkboxBackground": "#252740",
        "settings.checkboxForeground": "#e2dff0",
        "settings.textInputBackground": "#252740",
        "settings.textInputForeground": "#e2dff0",
        "settings.numberInputBackground": "#252740",
        "settings.numberInputForeground": "#e2dff0",

        "breadcrumb.foreground": "#e2dff0",
        "breadcrumb.background": "#1a1b2e",
        "breadcrumb.focusForeground": "#ffffff",
        "breadcrumbPicker.background": "#1a1b2e",

        "notebook.editorBackground": "#1a1b2e",
        "notebook.cellBorderColor": "#252740",
        "notebook.cellHoverBackground": "#252740",
        "notebook.focusedCellBorder": "#a8d8b9",
        "notebook.selectedCellBackground": "#252740",

        "charts.foreground": "#e2dff0",
        "charts.lines": "#e2dff0",
        "charts.red": "#f2b5b5",
        "charts.blue": "#89ddff",
        "charts.yellow": "#f5e0b5",
        "charts.green": "#a8d8b9",
        "charts.purple": "#c9b5f5"
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": { "fontStyle": "italic", "foreground": "#6e6a9e" }
        },
        {
            "name": "Variables",
            "scope": ["variable", "variable.parameter"],
            "settings": { "foreground": "#f2b5b5" }
        },
        {
            "name": "Keyword",
            "scope": ["keyword", "storage.modifier", "keyword.control"],
            "settings": { "foreground": "#a8d8b9" }
        },
        {
            "name": "Function",
            "scope": ["entity.name.function", "meta.function-call", "support.function"],
            "settings": { "foreground": "#89ddff" }
        },
        {
            "name": "String",
            "scope": ["string"],
            "settings": { "foreground": "#a8d8b9" }
        },
        {
            "name": "Number",
            "scope": ["constant.numeric", "constant.language"],
            "settings": { "foreground": "#c9b5f5" }
        },
        {
            "name": "Type",
            "scope": ["entity.name.type", "support.type", "storage.type"],
            "settings": { "foreground": "#f5e0b5" }
        },
        {
            "name": "Class",
            "scope": ["entity.name.class", "support.class"],
            "settings": { "foreground": "#f5e0b5" }
        },
        {
            "name": "Tag",
            "scope": ["entity.name.tag"],
            "settings": { "foreground": "#f2b5b5" }
        },
        {
            "name": "Attribute",
            "scope": ["entity.other.attribute-name"],
            "settings": { "foreground": "#89ddff" }
        },
        {
            "name": "Constant",
            "scope": ["constant", "support.constant"],
            "settings": { "foreground": "#c9b5f5" }
        },
        {
            "name": "Operator",
            "scope": ["keyword.operator", "punctuation"],
            "settings": { "foreground": "#f5bde6" }
        },
        {
            "name": "Embedded",
            "scope": ["punctuation.section.embedded", "variable.interpolation"],
            "settings": { "foreground": "#f5bde6" }
        },
        {
            "name": "Markup Heading",
            "scope": ["markup.heading"],
            "settings": { "foreground": "#89ddff", "fontStyle": "bold" }
        },
        {
            "name": "Markup Italic",
            "scope": ["markup.italic"],
            "settings": { "fontStyle": "italic", "foreground": "#f5bde6" }
        },
        {
            "name": "Markup Bold",
            "scope": ["markup.bold"],
            "settings": { "fontStyle": "bold", "foreground": "#f5bde6" }
        },
        {
            "name": "Markup Link",
            "scope": ["string.other.link", "markup.underline"],
            "settings": { "foreground": "#89ddff" }
        },
        {
            "name": "Markup List",
            "scope": ["punctuation.definition.list_item"],
            "settings": { "foreground": "#a8d8b9" }
        },
        {
            "name": "Markup Quote",
            "scope": ["markup.quote"],
            "settings": { "foreground": "#6e6a9e", "fontStyle": "italic" }
        },
        {
            "name": "Markup Raw",
            "scope": ["markup.raw", "markup.inline.raw"],
            "settings": { "foreground": "#c9b5f5" }
        },
        {
            "name": "CSS Properties",
            "scope": ["support.type.property-name"],
            "settings": { "foreground": "#89ddff" }
        },
        {
            "name": "JSON Key",
            "scope": ["support.type.property-name.json"],
            "settings": { "foreground": "#89ddff" }
        }
    ]
}
