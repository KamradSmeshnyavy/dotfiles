        "editor.lineHighlightBackground": "#121326",
        "editorWhitespace.foreground": "#252740",
        "editorIndentGuide.background": "#252740",
        "editorIndentGuide.activeBackground": "#6e6a9e",

        "editorBracketMatch.background": "#252740",
