// surface: omarchy-themes/surface/build.py по палитре темы
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/apps/saturn-logo.txt",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " ▐ ",
    "color": {
      "separator": "38;2;84;102;112",
      "output": "38;2;37;46;51"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "title",
      "color": {
        "user": "38;2;58;148;197",
        "at": "38;2;74;107;112",
        "host": "38;2;58;148;197"
      }
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "38;2;195;59;57"
    },
    {
      "type": "os",
      "key": " ",
      "keyColor": "38;2;58;148;197",
      "format": "{3}"
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "38;2;22;74;43",
      "format": "{2}"
    },
    {
      "type": "packages",
      "key": " ",
      "keyColor": "38;2;114;158;90"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "38;2;223;160;0",
      "format": "{1} {4}"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "38;2;22;74;43"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "38;2;223;105;186"
    },
    {
      "type": "display",
      "key": "󰍹 ",
      "keyColor": "38;2;74;107;112",
      "format": "{1}x{2}",
      "compactType": "original"
    },
    {
      "type": "colors",
      "paddingLeft": 0,
      "symbol": "circle",
      "block": {
        "range": [
          0,
          15
        ],
        "width": 3
      }
    }
  ]
}
