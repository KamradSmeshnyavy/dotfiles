{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#252e33",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#4f6b5b",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#f0ece6",
		"background_color": "#4f6b5b",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#4f6b5b"
	},
	"h3": {
		"prefix": "### ",
		"color": "#32403f"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#32403f"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#546670"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#546670",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#c9c2b6",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#32403f",
		"underline": true
	},
	"link_text": {
		"color": "#4f6b5b",
		"bold": true
	},
	"image": {
		"color": "#bb3c3e",
		"underline": true
	},
	"image_text": {
		"color": "#848584",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#bb3c3e",
		"background_color": "#d8d2c8"
	},
	"code_block": {
		"color": "#252e33",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#252e33"
			},
			"error": {
				"color": "#bb3c3e",
				"background_color": "#d8d2c8"
			},
			"comment": {
				"color": "#848584"
			},
			"comment_preproc": {
				"color": "#bb3c3e"
			},
			"keyword": {
				"color": "#4f6b5b"
			},
			"keyword_reserved": {
				"color": "#bb3c3e"
			},
			"keyword_namespace": {
				"color": "#4a6b70"
			},
			"keyword_type": {
				"color": "#252e33"
			},
			"operator": {
				"color": "#546670"
			},
			"punctuation": {
				"color": "#546670"
			},
			"name": {
				"color": "#252e33"
			},
			"name_builtin": {
				"color": "#4a6b70"
			},
			"name_tag": {
				"color": "#4f6b5b"
			},
			"name_attribute": {
				"color": "#32403f"
			},
			"name_class": {
				"color": "#252e33",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#4a6b70"
			},
			"name_exception": {
				"color": "#bb3c3e"
			},
			"name_function": {
				"color": "#32403f"
			},
			"name_other": {
				"color": "#252e33"
			},
			"literal": {
				"color": "#546670"
			},
			"literal_number": {
				"color": "#4a6b70"
			},
			"literal_date": {
				"color": "#546670"
			},
			"literal_string": {
				"color": "#3c5049"
			},
			"literal_string_escape": {
				"color": "#bb3c3e"
			},
			"generic_deleted": {
				"color": "#bb3c3e"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#3c5049"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#546670"
			},
			"background": {
				"background_color": "#e3ded6"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
