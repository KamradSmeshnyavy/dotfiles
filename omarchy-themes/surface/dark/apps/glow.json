{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#e5dfc5",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#a7c080",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#141719",
		"background_color": "#a7c080",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#a7c080"
	},
	"h3": {
		"prefix": "### ",
		"color": "#d2d6b0"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#d2d6b0"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#9da9a0"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#9da9a0",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#374145",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#d2d6b0",
		"underline": true
	},
	"link_text": {
		"color": "#a7c080",
		"bold": true
	},
	"image": {
		"color": "#e67e80",
		"underline": true
	},
	"image_text": {
		"color": "#727166",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#e67e80",
		"background_color": "#2d353b"
	},
	"code_block": {
		"color": "#e5dfc5",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#e5dfc5"
			},
			"error": {
				"color": "#e67e80",
				"background_color": "#2d353b"
			},
			"comment": {
				"color": "#727166"
			},
			"comment_preproc": {
				"color": "#e67e80"
			},
			"keyword": {
				"color": "#a7c080"
			},
			"keyword_reserved": {
				"color": "#e67e80"
			},
			"keyword_namespace": {
				"color": "#83c092"
			},
			"keyword_type": {
				"color": "#e5dfc5"
			},
			"operator": {
				"color": "#9da9a0"
			},
			"punctuation": {
				"color": "#9da9a0"
			},
			"name": {
				"color": "#e5dfc5"
			},
			"name_builtin": {
				"color": "#83c092"
			},
			"name_tag": {
				"color": "#a7c080"
			},
			"name_attribute": {
				"color": "#d2d6b0"
			},
			"name_class": {
				"color": "#e5dfc5",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#83c092"
			},
			"name_exception": {
				"color": "#e67e80"
			},
			"name_function": {
				"color": "#d2d6b0"
			},
			"name_other": {
				"color": "#e5dfc5"
			},
			"literal": {
				"color": "#9da9a0"
			},
			"literal_number": {
				"color": "#83c092"
			},
			"literal_date": {
				"color": "#9da9a0"
			},
			"literal_string": {
				"color": "#c3ce9f"
			},
			"literal_string_escape": {
				"color": "#e67e80"
			},
			"generic_deleted": {
				"color": "#e67e80"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#c3ce9f"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#9da9a0"
			},
			"background": {
				"background_color": "#1e2326"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
