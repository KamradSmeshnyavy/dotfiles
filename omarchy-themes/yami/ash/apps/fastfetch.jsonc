// YAMI: omarchy-themes/yami/build.py по палитре темы
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/apps/yami-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;168;162;156",
      "title": "38;2;218;211;203",
      "output": "38;2;232;226;224",
      "separator": "38;2;66;63;61"
    },
    "key": {
      "width": 8
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 12,
      "border": {
        "left": "",
        "right": ""
      }
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;120;200;120",
        "yellow": "38;2;255;170;40",
        "red": "38;2;218;211;203"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;168;162;156mYAMI \u001b[38;2;100;90;89m// \u001b[38;2;143;134;133mhyprland"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;66;63;61m──────────────────────────────"
    },
    {
      "type": "title",
      "key": "host",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "os",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "term",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;14;12;12m   \u001b[48;2;22;20;20m   \u001b[48;2;66;63;61m   \u001b[48;2;105;101;98m   \u001b[48;2;168;162;156m   \u001b[48;2;218;211;203m   \u001b[48;2;143;134;133m   \u001b[48;2;232;226;224m   \u001b[0m"
    }
  ]
}
