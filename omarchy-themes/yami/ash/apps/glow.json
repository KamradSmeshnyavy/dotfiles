{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#e8e2e0",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#dad3cb",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#0e0c0c",
		"background_color": "#dad3cb",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#a8a29c"
	},
	"h3": {
		"prefix": "### ",
		"color": "#e4dedb"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#e4dedb"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#8f8685"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#8f8685",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#423f3d",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#e4dedb",
		"underline": true
	},
	"link_text": {
		"color": "#dad3cb",
		"bold": true
	},
	"image": {
		"color": "#a8a29c",
		"underline": true
	},
	"image_text": {
		"color": "#6d6463",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#a8a29c",
		"background_color": "#221e1e"
	},
	"code_block": {
		"color": "#e8e2e0",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#e8e2e0"
			},
			"error": {
				"color": "#dad3cb",
				"background_color": "#221e1e"
			},
			"comment": {
				"color": "#6d6463"
			},
			"comment_preproc": {
				"color": "#a8a29c"
			},
			"keyword": {
				"color": "#dad3cb"
			},
			"keyword_reserved": {
				"color": "#dad3cb"
			},
			"keyword_namespace": {
				"color": "#928d88"
			},
			"keyword_type": {
				"color": "#e8e2e0"
			},
			"operator": {
				"color": "#8f8685"
			},
			"punctuation": {
				"color": "#8f8685"
			},
			"name": {
				"color": "#e8e2e0"
			},
			"name_builtin": {
				"color": "#928d88"
			},
			"name_tag": {
				"color": "#dad3cb"
			},
			"name_attribute": {
				"color": "#e4dedb"
			},
			"name_class": {
				"color": "#e8e2e0",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#928d88"
			},
			"name_exception": {
				"color": "#dad3cb"
			},
			"name_function": {
				"color": "#e4dedb"
			},
			"name_other": {
				"color": "#e8e2e0"
			},
			"literal": {
				"color": "#8f8685"
			},
			"literal_number": {
				"color": "#928d88"
			},
			"literal_date": {
				"color": "#8f8685"
			},
			"literal_string": {
				"color": "#d0cac6"
			},
			"literal_string_escape": {
				"color": "#a8a29c"
			},
			"generic_deleted": {
				"color": "#dad3cb"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#d0cac6"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#8f8685"
			},
			"background": {
				"background_color": "#161414"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
