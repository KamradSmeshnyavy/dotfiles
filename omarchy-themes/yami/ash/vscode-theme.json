  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6d6463",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#dad3cb"
      }
    },
    {
      "scope": [
        "keyword.control.flow",
        "keyword.control.return"
      ],
      "settings": {
        "foreground": "#dad3cb",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#d0cac6"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#a8a29c"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language"
      ],
      "settings": {
        "foreground": "#928d88"
      }
    },
    {
      "scope": [
        "constant",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#e0dad4"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#e8e2e0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#e4dedb"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "entity.other.attribute-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#8f8685"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#e8e2e0"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e8e2e0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#dad3cb",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#8f8685"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#dad3cb"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "entity.name.function.macro",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#a8a29c"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#a8a29c",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#e8e2e0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e8e2e0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#e4dedb",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.list.unnumbered",
        "markup.list.numbered",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#a8a29c"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8f8685",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#c5bfbb"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#dad3cb"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8f8685"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#dad3cb"
      }
    }
  ],
  "semanticTokenColors": {
    "class": {
      "foreground": "#e8e2e0",
      "fontStyle": ""
    },
    "interface": {
      "foreground": "#e8e2e0",
      "fontStyle": "italic"
    },
    "enum": {
      "foreground": "#e8e2e0",
      "fontStyle": ""
    },
    "struct": {
      "foreground": "#e8e2e0",
      "fontStyle": ""
    },
    "type": {
      "foreground": "#e8e2e0",
      "fontStyle": ""
    },
    "typeParameter": {
      "foreground": "#e8e2e0",
      "fontStyle": "italic"
    },
    "namespace": "#e8e2e0",
    "function": "#e4dedb",
    "method": "#e4dedb",
    "macro": "#a8a29c",
    "decorator": "#a8a29c",
    "property": "#8f8685",
    "enumMember": "#e0dad4",
    "parameter": {
      "foreground": "#e8e2e0",
      "fontStyle": "italic"
    },
    "variable": "#e8e2e0",
    "variable.readonly": "#e0dad4",
    "keyword": {
      "foreground": "#dad3cb",
      "fontStyle": ""
    },
    "string": "#d0cac6",
    "number": "#928d88",
    "regexp": "#a8a29c",
    "operator": "#8f8685",
    "*.deprecated": {
      "fontStyle": "strikethrough"
    }
  }
}
