{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#e9dbda",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#ff1d24",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#0f0808",
		"background_color": "#ff1d24",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#c4161c"
	},
	"h3": {
		"prefix": "### ",
		"color": "#eeacac"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#eeacac"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#937576"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#937576",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#4c1012",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#eeacac",
		"underline": true
	},
	"link_text": {
		"color": "#ff1d24",
		"bold": true
	},
	"image": {
		"color": "#d1494e",
		"underline": true
	},
	"image_text": {
		"color": "#6f5758",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#d1494e",
		"background_color": "#241314"
	},
	"code_block": {
		"color": "#e9dbda",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#e9dbda"
			},
			"error": {
				"color": "#ff1d24",
				"background_color": "#241314"
			},
			"comment": {
				"color": "#6f5758"
			},
			"comment_preproc": {
				"color": "#d1494e"
			},
			"keyword": {
				"color": "#ff1d24"
			},
			"keyword_reserved": {
				"color": "#ff1d24"
			},
			"keyword_namespace": {
				"color": "#c45c60"
			},
			"keyword_type": {
				"color": "#e9dbda"
			},
			"operator": {
				"color": "#937576"
			},
			"punctuation": {
				"color": "#937576"
			},
			"name": {
				"color": "#e9dbda"
			},
			"name_builtin": {
				"color": "#c45c60"
			},
			"name_tag": {
				"color": "#ff1d24"
			},
			"name_attribute": {
				"color": "#eeacac"
			},
			"name_class": {
				"color": "#e9dbda",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#c45c60"
			},
			"name_exception": {
				"color": "#ff1d24"
			},
			"name_function": {
				"color": "#eeacac"
			},
			"name_other": {
				"color": "#e9dbda"
			},
			"literal": {
				"color": "#937576"
			},
			"literal_number": {
				"color": "#c45c60"
			},
			"literal_date": {
				"color": "#937576"
			},
			"literal_string": {
				"color": "#db9092"
			},
			"literal_string_escape": {
				"color": "#d1494e"
			},
			"generic_deleted": {
				"color": "#ff1d24"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#db9092"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#937576"
			},
			"background": {
				"background_color": "#180d0d"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
