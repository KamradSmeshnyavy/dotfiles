{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#e6dee5",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#9362ff",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#0d0a0f",
		"background_color": "#9362ff",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#8a5cf0"
	},
	"h3": {
		"prefix": "### ",
		"color": "#d1bfec"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#d1bfec"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#8c7d8f"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#8c7d8f",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#38275a",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#d1bfec",
		"underline": true
	},
	"link_text": {
		"color": "#9362ff",
		"bold": true
	},
	"image": {
		"color": "#8a5cf0",
		"underline": true
	},
	"image_text": {
		"color": "#6a5d6b",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#8a5cf0",
		"background_color": "#1f1925"
	},
	"code_block": {
		"color": "#e6dee5",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#e6dee5"
			},
			"error": {
				"color": "#9362ff",
				"background_color": "#1f1925"
			},
			"comment": {
				"color": "#6a5d6b"
			},
			"comment_preproc": {
				"color": "#8a5cf0"
			},
			"keyword": {
				"color": "#9362ff"
			},
			"keyword_reserved": {
				"color": "#9362ff"
			},
			"keyword_namespace": {
				"color": "#8864d7"
			},
			"keyword_type": {
				"color": "#e6dee5"
			},
			"operator": {
				"color": "#8c7d8f"
			},
			"punctuation": {
				"color": "#8c7d8f"
			},
			"name": {
				"color": "#e6dee5"
			},
			"name_builtin": {
				"color": "#8864d7"
			},
			"name_tag": {
				"color": "#9362ff"
			},
			"name_attribute": {
				"color": "#d1bfec"
			},
			"name_class": {
				"color": "#e6dee5",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#8864d7"
			},
			"name_exception": {
				"color": "#9362ff"
			},
			"name_function": {
				"color": "#d1bfec"
			},
			"name_other": {
				"color": "#e6dee5"
			},
			"literal": {
				"color": "#8c7d8f"
			},
			"literal_number": {
				"color": "#8864d7"
			},
			"literal_date": {
				"color": "#8c7d8f"
			},
			"literal_string": {
				"color": "#c3ade9"
			},
			"literal_string_escape": {
				"color": "#8a5cf0"
			},
			"generic_deleted": {
				"color": "#9362ff"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#c3ade9"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#8c7d8f"
			},
			"background": {
				"background_color": "#151019"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
