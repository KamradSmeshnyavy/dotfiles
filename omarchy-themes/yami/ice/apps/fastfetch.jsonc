// YAMI: omarchy-themes/yami/build.py по палитре темы
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/apps/yami-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;58;159;208",
      "title": "38;2;71;195;255",
      "output": "38;2;226;226;227",
      "separator": "38;2;29;62;78"
    },
    "key": {
      "width": 8
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 12,
      "border": {
        "left": "",
        "right": ""
      }
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;120;200;120",
        "yellow": "38;2;255;170;40",
        "red": "38;2;71;195;255"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;58;159;208mYAMI \u001b[38;2;89;90;95m// \u001b[38;2;130;133;139mhyprland"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;29;62;78m──────────────────────────────"
    },
    {
      "type": "title",
      "key": "host",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "os",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "term",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;10;12;14m   \u001b[48;2;16;20;23m   \u001b[48;2;29;62;78m   \u001b[48;2;36;99;130m   \u001b[48;2;58;159;208m   \u001b[48;2;71;195;255m   \u001b[48;2;130;133;139m   \u001b[48;2;226;226;227m   \u001b[0m"
    }
  ]
}
