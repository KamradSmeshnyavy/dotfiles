// YAMI: omarchy-themes/yami/build.py по палитре темы
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/apps/yami-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;217;142;31",
      "title": "38;2;255;167;36",
      "output": "38;2;234;225;218",
      "separator": "38;2;83;56;18"
    },
    "key": {
      "width": 8
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 12,
      "border": {
        "left": "",
        "right": ""
      }
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;120;200;120",
        "yellow": "38;2;255;170;40",
        "red": "38;2;255;167;36"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;217;142;31mYAMI \u001b[38;2;104;88;77m// \u001b[38;2;149;131;118mhyprland"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;83;56;18m──────────────────────────────"
    },
    {
      "type": "title",
      "key": "host",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "os",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "term",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;15;12;8m   \u001b[48;2;25;19;13m   \u001b[48;2;83;56;18m   \u001b[48;2;136;89;19m   \u001b[48;2;217;142;31m   \u001b[48;2;255;167;36m   \u001b[48;2;149;131;118m   \u001b[48;2;234;225;218m   \u001b[0m"
    }
  ]
}
