// YAMI: omarchy-themes/yami/build.py по палитре темы
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.local/state/omarchy/current/theme/apps/yami-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;95;174;52",
      "title": "38;2;123;226;68",
      "output": "38;2;228;226;219",
      "separator": "38;2;41;67;25"
    },
    "key": {
      "width": 8
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 12,
      "border": {
        "left": "",
        "right": ""
      }
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;120;200;120",
        "yellow": "38;2;255;170;40",
        "red": "38;2;123;226;68"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;95;174;52mYAMI \u001b[38;2;92;91;79m// \u001b[38;2;135;135;121mhyprland"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;41;67;25m──────────────────────────────"
    },
    {
      "type": "title",
      "key": "host",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "os",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "term",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "uptime"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[48;2;11;13;9m   \u001b[48;2;18;21;14m   \u001b[48;2;41;67;25m   \u001b[48;2;59;109;32m   \u001b[48;2;95;174;52m   \u001b[48;2;123;226;68m   \u001b[48;2;135;135;121m   \u001b[48;2;228;226;219m   \u001b[0m"
    }
  ]
}
