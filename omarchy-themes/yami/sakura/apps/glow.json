{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#eadedf",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#ff6692",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#0f0a0b",
		"background_color": "#ff6692",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#d9577c"
	},
	"h3": {
		"prefix": "### ",
		"color": "#efc0cc"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#efc0cc"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#957d81"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#957d81",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#532532",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#efc0cc",
		"underline": true
	},
	"link_text": {
		"color": "#ff6692",
		"bold": true
	},
	"image": {
		"color": "#d9577c",
		"underline": true
	},
	"image_text": {
		"color": "#715c60",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#d9577c",
		"background_color": "#26181b"
	},
	"code_block": {
		"color": "#eadedf",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#eadedf"
			},
			"error": {
				"color": "#ff6692",
				"background_color": "#26181b"
			},
			"comment": {
				"color": "#715c60"
			},
			"comment_preproc": {
				"color": "#d9577c"
			},
			"keyword": {
				"color": "#ff6692"
			},
			"keyword_reserved": {
				"color": "#ff6692"
			},
			"keyword_namespace": {
				"color": "#c15775"
			},
			"keyword_type": {
				"color": "#eadedf"
			},
			"operator": {
				"color": "#957d81"
			},
			"punctuation": {
				"color": "#957d81"
			},
			"name": {
				"color": "#eadedf"
			},
			"name_builtin": {
				"color": "#c15775"
			},
			"name_tag": {
				"color": "#ff6692"
			},
			"name_attribute": {
				"color": "#efc0cc"
			},
			"name_class": {
				"color": "#eadedf",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#c15775"
			},
			"name_exception": {
				"color": "#ff6692"
			},
			"name_function": {
				"color": "#efc0cc"
			},
			"name_other": {
				"color": "#eadedf"
			},
			"literal": {
				"color": "#957d81"
			},
			"literal_number": {
				"color": "#c15775"
			},
			"literal_date": {
				"color": "#957d81"
			},
			"literal_string": {
				"color": "#e4abb9"
			},
			"literal_string_escape": {
				"color": "#d9577c"
			},
			"generic_deleted": {
				"color": "#ff6692"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#e4abb9"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#957d81"
			},
			"background": {
				"background_color": "#191012"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
