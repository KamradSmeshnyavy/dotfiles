[Plymouth Theme]
Name=DOT-MATRIX
Description=ex nihilo — Arch LED matrix splash
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/dot-matrix
ScriptFile=/usr/share/plymouth/themes/dot-matrix/dot-matrix.script
