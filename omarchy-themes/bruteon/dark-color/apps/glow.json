{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#f3e6dc",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#b478c8",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#1d1816",
		"background_color": "#b478c8",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#ffb77a"
	},
	"h3": {
		"prefix": "### ",
		"color": "#90caf9"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#90caf9"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#ff8a80"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#ff8a80",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#524c48",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#90caf9",
		"underline": true
	},
	"link_text": {
		"color": "#b478c8",
		"bold": true
	},
	"image": {
		"color": "#87aeaa",
		"underline": true
	},
	"image_text": {
		"color": "#947460",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#87aeaa",
		"background_color": "#4a372c"
	},
	"code_block": {
		"color": "#f3e6dc",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#f3e6dc"
			},
			"error": {
				"color": "#ff8a80",
				"background_color": "#4a372c"
			},
			"comment": {
				"color": "#947460"
			},
			"comment_preproc": {
				"color": "#87aeaa"
			},
			"keyword": {
				"color": "#b478c8"
			},
			"keyword_reserved": {
				"color": "#ff8a80"
			},
			"keyword_namespace": {
				"color": "#ffb77a"
			},
			"keyword_type": {
				"color": "#f2c16a"
			},
			"operator": {
				"color": "#ff8a80"
			},
			"punctuation": {
				"color": "#c79b7f"
			},
			"name": {
				"color": "#f3e6dc"
			},
			"name_builtin": {
				"color": "#ffb77a"
			},
			"name_tag": {
				"color": "#b478c8"
			},
			"name_attribute": {
				"color": "#90caf9"
			},
			"name_class": {
				"color": "#f2c16a",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#ffb77a"
			},
			"name_exception": {
				"color": "#ff8a80"
			},
			"name_function": {
				"color": "#90caf9"
			},
			"name_other": {
				"color": "#f3e6dc"
			},
			"literal": {
				"color": "#ff8a80"
			},
			"literal_number": {
				"color": "#ffb77a"
			},
			"literal_date": {
				"color": "#ff8a80"
			},
			"literal_string": {
				"color": "#c5e1a5"
			},
			"literal_string_escape": {
				"color": "#87aeaa"
			},
			"generic_deleted": {
				"color": "#ff8a80"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#c5e1a5"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#c79b7f"
			},
			"background": {
				"background_color": "#2a2320"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
