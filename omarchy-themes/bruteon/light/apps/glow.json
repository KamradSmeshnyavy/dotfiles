{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#161110",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "│ "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#6b3b05",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#efe0d6",
		"background_color": "#6b3b05",
		"bold": true
	},
	"h2": {
		"prefix": "## ",
		"color": "#ffb77a"
	},
	"h3": {
		"prefix": "### ",
		"color": "#40260a"
	},
	"h4": {
		"prefix": "#### ",
		"color": "#40260a"
	},
	"h5": {
		"prefix": "##### ",
		"color": "#885643"
	},
	"h6": {
		"prefix": "###### ",
		"color": "#885643",
		"bold": false
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#b9aca4",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "• "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[✓] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#40260a",
		"underline": true
	},
	"link_text": {
		"color": "#6b3b05",
		"bold": true
	},
	"image": {
		"color": "#a93f34",
		"underline": true
	},
	"image_text": {
		"color": "#9d7768",
		"format": "Image: {{.text}} →"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#a93f34",
		"background_color": "#e3c0a5"
	},
	"code_block": {
		"color": "#161110",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#161110"
			},
			"error": {
				"color": "#a93f34",
				"background_color": "#e3c0a5"
			},
			"comment": {
				"color": "#9d7768"
			},
			"comment_preproc": {
				"color": "#a93f34"
			},
			"keyword": {
				"color": "#6b3b05"
			},
			"keyword_reserved": {
				"color": "#a93f34"
			},
			"keyword_namespace": {
				"color": "#815c3e"
			},
			"keyword_type": {
				"color": "#161110"
			},
			"operator": {
				"color": "#885643"
			},
			"punctuation": {
				"color": "#885643"
			},
			"name": {
				"color": "#161110"
			},
			"name_builtin": {
				"color": "#815c3e"
			},
			"name_tag": {
				"color": "#6b3b05"
			},
			"name_attribute": {
				"color": "#40260a"
			},
			"name_class": {
				"color": "#161110",
				"underline": true,
				"bold": true
			},
			"name_constant": {
				"color": "#815c3e"
			},
			"name_exception": {
				"color": "#a93f34"
			},
			"name_function": {
				"color": "#40260a"
			},
			"name_other": {
				"color": "#161110"
			},
			"literal": {
				"color": "#885643"
			},
			"literal_number": {
				"color": "#815c3e"
			},
			"literal_date": {
				"color": "#885643"
			},
			"literal_string": {
				"color": "#83583f"
			},
			"literal_string_escape": {
				"color": "#a93f34"
			},
			"generic_deleted": {
				"color": "#a93f34"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#83583f"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#885643"
			},
			"background": {
				"background_color": "#f5ebe6"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n🠶 "
	},
	"html_block": {},
	"html_span": {}
}
