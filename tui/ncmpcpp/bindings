# Move up and down
def_key "j"
  scroll_down
def_key "k"
  scroll_up

# Move back/forward (in browser/library)
def_key "h"
  previous_column
def_key "l"
  next_column
def_key "l"
  play_item

# Go to top/bottom
def_key "g"
  move_home
def_key "G"
  move_end

