#!/usr/bin/env python3
# git clean-фильтр для apps/vscode/settings.json (.gitattributes: filter=vscode-local, подключает `just link`).
#
# settings.json — симлинк файла, include у VS Code нет, а локальные значения пишут:
#   omarchy-font-profile        — editor/terminal/debug/markdown fontFamily (первая гарнитура) и fontSize;
#   omarchy-theme-set-vscode    — workbench.colorTheme при каждой смене темы Omarchy.
# В индекс эти ключи попадают с каноническими значениями ниже, поэтому смена шрифта или темы не даёт диффа.
# Всё остальное проходит байт-в-байт. Поменять значение в репозитории — только здесь, в CANON.
import re
import sys

CANON = {
    "workbench.colorTheme": "Catppuccin Mocha",
    "editor.fontSize": "16",
    "terminal.integrated.fontSize": "13",
}
# fontFamily — заменяется только первая гарнитура списка (как в omarchy-font-profile), запасные остаются.
FIRST_FONT = "Maple Mono NF CN"
FONT_KEYS = ("editor.fontFamily", "terminal.integrated.fontFamily", "debug.console.fontFamily",
             "markdown.preview.fontFamily")

text = sys.stdin.read()
for key, value in CANON.items():
    q = re.escape(key)
    if value.replace(".", "", 1).isdigit():
        text = re.sub(r'("%s":\s*)[0-9.]+' % q, lambda m: m.group(1) + value, text, count=1)
    else:
        text = re.sub(r'("%s":\s*")[^"]*' % q, lambda m: m.group(1) + value, text, count=1)
for key in FONT_KEYS:
    text = re.sub(r'("%s":\s*")([^",]*)' % re.escape(key), lambda m: m.group(1) + FIRST_FONT, text, count=1)
sys.stdout.write(text)
