#!/usr/bin/env bash

# Force bash for fzf previews
export SHELL=$(which bash)

mkdir -p ~/dotfiles/apps/hyprland/

MENU_OPTIONS="1. 🎨 Hyprland Animations\n2. 📊 Shell Layouts\n3. 🖌️ Omarchy Themes\n4. 🖼️ Recolor Wallpaper (Lutgen)\n5. ❌ Exit"
CHOICE=$(echo -e "$MENU_OPTIONS" | fzf --prompt="Select Category: " --height=15 --border=rounded)

if [[ "$CHOICE" == *"Hyprland Animations"* ]]; then
    ANIM_DIR="$HOME/dotfiles/apps/hyprland/animations_lua"
    cd "$ANIM_DIR" || exit
    
    cp "$HOME/dotfiles/apps/hyprland/active_animations.lua" "/tmp/backup_anim.lua" 2>/dev/null || true

    PREVIEW_CMD="cp {} \"$HOME/dotfiles/apps/hyprland/active_animations.lua\" && hyprctl reload >/dev/null 2>&1; cat {}"
    SELECTED=$(find . -maxdepth 1 -name "*.lua" | sed 's|^\./||' | sort | fzf --prompt="Select Animation: " --preview "$PREVIEW_CMD" --preview-window="right:60%:wrap" --height=80% --border=rounded)
    
    if [ -n "$SELECTED" ]; then
        cp "$SELECTED" "$HOME/dotfiles/apps/hyprland/active_animations.lua"
        hyprctl reload >/dev/null 2>&1
        notify-send -t 2000 "Animations" "Loaded: $SELECTED"
    else
        cp "/tmp/backup_anim.lua" "$HOME/dotfiles/apps/hyprland/active_animations.lua" 2>/dev/null || true
        hyprctl reload >/dev/null 2>&1
    fi

elif [[ "$CHOICE" == *"Shell Layouts"* ]]; then
    LAYOUT_DIR="$HOME/.config/omarchy"
    cd "$LAYOUT_DIR" || exit
    cp "shell.json" "/tmp/backup_shell.json" 2>/dev/null || true
    PREVIEW_CMD="cp {} shell.json && omarchy restart shell >/dev/null 2>&1; cat {}"
    SELECTED=$(ls shell-*.json | sort | fzf --prompt="Select Shell Layout: " --preview "$PREVIEW_CMD" --preview-window="right:60%:wrap" --height=80% --border=rounded)
    if [ -n "$SELECTED" ]; then
        cp "$SELECTED" shell.json
        omarchy restart shell >/dev/null 2>&1
        notify-send -t 2000 "Shell Layout" "Applied: $SELECTED"
    else
        cp "/tmp/backup_shell.json" shell.json
        omarchy restart shell >/dev/null 2>&1
    fi

elif [[ "$CHOICE" == *"Omarchy Themes"* ]]; then
    uwsm-app -- xdg-terminal-exec -- omarchy theme set

elif [[ "$CHOICE" == *"Recolor Wallpaper"* ]]; then
    WP_DIR="$HOME/Wallpapers"
    [ ! -d "$WP_DIR" ] && WP_DIR="$HOME/Pictures"
    SELECTED_WP=$(find "$WP_DIR" -type f \( -name "*.jpg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | fzf --prompt="Select Wallpaper: " --preview="kitty +kitten icat --clear --transfer-mode=memory --place=40x40@0x0 {}" --height=80% --border=rounded)
    if [ -n "$SELECTED_WP" ]; then
        THEME_NAME=$(cat ~/.local/state/omarchy/current/theme.name 2>/dev/null || echo "default")
        THEME_DIR="$HOME/.config/omarchy/themes/$THEME_NAME"
        if [ ! -d "$THEME_DIR" ]; then
            notify-send "Wallpaper" "Cannot recolor stock Omarchy theme. Please use a custom theme."
            exit 1
        fi
        TMP_SRC="/tmp/omarchy_lutgen_src"
        mkdir -p "$TMP_SRC"
        rm -f "$TMP_SRC"/*
        cp "$SELECTED_WP" "$TMP_SRC/"
        notify-send -t 3000 "Wallpaper" "Recoloring $(basename "$SELECTED_WP") with Lutgen..."
        ~/dotfiles/omarchy-themes/scripts/omarchy-lutgen-wallpapers "$THEME_DIR" "$TMP_SRC"
        omarchy theme bg set "$THEME_DIR/backgrounds/$(basename "$SELECTED_WP")"
        notify-send -t 3000 "Wallpaper" "Applied $(basename "$SELECTED_WP")!"
    fi
fi
