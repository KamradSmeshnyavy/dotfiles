#!/usr/bin/env bash
# Профиль шрифтов всей системы — в духе Nothing OS. Один выбор меняет шрифт терминалов, fontconfig, GTK,
# VS Code, браузера (Dark Reader, Stylus) и DOT-MATRIX-оболочки.
#
#   omarchy-font-profile                 # текущий профиль
#   omarchy-font-profile list            # профили с описанием (для Customizer)
#   omarchy-font-profile <profile>       # применить (список — `list`)
#   omarchy-font-profile apply           # применить сохранённый (после установки шрифтов)
#   omarchy-font-profile build-fonts     # собрать DotMatrix Mono, Pixel, LED и Board (just dotmatrix-fonts)
#
# Профили:
#   stock   — как было: Maple Mono NF CN везде; точечный DotMatrix Dot только в DOT-MATRIX-виджетах.
#   nothing — как Nothing OS: точками только часы, цифры, крупные заголовки; текст Geist, код DotMatrix Mono.
#   dot     — точечный слой: DotMatrix Dot во всём крупном и коротком (бар, заголовки, лаунчер, lock, OSD,
#             заголовки страниц); текст и код как в nothing.
#   pixel   — как dot, а терминал и код пиксельные (DotMatrix Pixel).
#   dot-accents — точечные акценты: как pixel, плюс DotMatrix Dot в заголовках и элементах сайтов, жирный текст
#             терминала (kitty / ghostty) и подписи оболочки (карточки, уведомления, меню, Customizer).
#   dots-all — точки везде: абсолютно любой знак — DotMatrix LED (Terminus 8×16, пиксель → точка, недостающее —
#             из DejaVu Sans Mono) в интерфейсе, на сайтах, в заголовках, терминале и коде.
#   dots-all-test-{a…f} — проба нового «точки везде»: DotMatrix Board (сетка 5×7, как у табло) вместо DotMatrix LED,
#             шесть вариантов точки (BOARD_VARIANTS): a/b/c — круглая 65/72/80 % шага, d/e/f — квадратная (LCD).
#             Board Sans — интерфейс и сайты, Board Mono — терминал и код. Размеры по сетке (шаг точки — 10 % кегля):
#             терминалы 15 pt, VS Code 20 px — шаг 4 физ. px при масштабе 2; интерфейс GTK 11.25 pt — шаг 3 px.
#             Прежние размеры запоминаются и возвращаются при смене профиля.
#   dots-all-lumen — «идеальный» вариант точек везде: DotMatrix Lumen. Lumen Sans (5×7, круглая точка 74 %, разрядка
#             в полточки) — интерфейс и сайты; Lumen Mono (то же, с лигатурами -> <- => == != точками) — терминал и код;
#             заголовки — DotMatrix Dot (мелкая сетка Doto хороша только крупно). Размеры по сетке, как у dots-all-test-*.
#   lumen   — семейство Lumen, как задумано: размер сетки по размеру текста. Всё мелкое — 5×7: интерфейс и заголовки
#             панелей Lumen Sans, терминал, код и метки оболочки Lumen Mono. DotMatrix Dot (мелкая сетка Doto) — только
#             в крупном: часы, OSD, lock, крупные цифры, на сайтах h1–h2. В отличие от dots-all-lumen, оболочка не
#             включает точечный слой (dotLayer): заголовки панелей 14 px Doto на них сливаются.
#   nothing-os-test — проба шрифтов Nothing OS: интерфейс NType 82, терминал и код Lettera Mono LL, заголовки Ndot 57.
#   ndot-test   — проба Ndot: интерфейс Ndot 57, заголовки Ndot 57 Caps, терминал и код DotMatrix Board B Mono.
#             Ndot / NType / Lettera — проприетарные (Nothing, Lineto): ставятся вручную в ~/.local/share/fonts/nothing-test,
#             в репозиторий не кладутся. Кириллицы в них нет (кроме Ndot Caps) — она из FALLBACK_SANS через fontconfig.
#   paper-shell — система как stock; рукописный Caveat только в оболочке (бар, панели) — стиль Paper.
#   paper-ui    — интерфейс Pangolin (рукописный печатный, читаемый), заголовки Caveat, терминал и код —
#                 рукописный моноширинный Monaspace Radon.
#   paper-hand  — Caveat везде, терминал и код — Monaspace Radon.
#   paper-all   — абсолютно всё в Caveat, включая терминал и код (шрифт не моноширинный).
#   retro       — интерфейс Pixelify Sans, терминал и код DotMatrix Pixel — стиль Retro.
# Caveat, Pangolin, Pixelify Sans и Monaspace Radon (OFL) лежат в kamradsmeshnyavy.customizer/fonts.
#
# DotMatrix Mono — Geist Mono с включёнными лигатурами; DotMatrix Pixel — Terminess (Terminus) с русскими «в д и й»,
# курсивом в ячейке и пиксельными лигатурами. Собираются из официальных шрифтов скриптами
# kamradsmeshnyavy.customizer/scripts/dotmatrix-{mono,pixel}.py в ~/.local/share/fonts/dotmatrix-build;
# значки Nerd Font терминалы берут из Symbols Nerd Font.
# DotMatrix Board (Mono / Sans) — Matrix Sans / Matrix Mono (FriedOrange, OFL, 5×7, с кириллицей) круглыми точками:
# scripts/dotmatrix-board.py, релиз Matrix Sans скачивается в кэш. DotMatrix LED (сетка 8×16) точек на обычном
# кегле не показывает — шаг точки 2–3 px, зазоров нет.
#
# Состояние: ~/.config/omarchy/fonts.json {"profile", "sans", "mono", "title"}. Его же читают dotmatrix/Palette.qml,
# BarStyle.qml (title — заголовки и рукописный шрифт панелей), omarchy-darkreader, omarchy-stylus, omarchy-firefox-chrome.
set -euo pipefail

CFG="$HOME/.config/omarchy/fonts.json"
FC_DIR="$HOME/.config/fontconfig/conf.d"
FC_FILE="$FC_DIR/60-dotmatrix-fonts.conf"
GEIST_DIR="$HOME/.local/share/fonts/geist"
GEIST_ZIP="https://github.com/vercel/geist-font/releases/download/v1.9.0/geist-font-v1.9.0.zip"
CACHE="$HOME/.cache/dotmatrix-fonts"
BUILD_DIR="$HOME/.local/share/fonts/dotmatrix-build"
FONT_SCRIPTS="$HOME/dotfiles/apps/omarchy-shell/plugins/kamradsmeshnyavy.customizer/scripts"
TERMINESS="/usr/share/fonts/TTF/TerminessNerdFont"
VSCODE="$HOME/.config/Code/User/settings.json"
THEMES="$HOME/dotfiles/omarchy-themes/scripts"

# profile|стиль|sans|mono|title (заголовки; пусто — как sans)|описание
STOCK_FONT="Maple Mono NF CN"
PROFILES=(
  "stock|base|$STOCK_FONT|$STOCK_FONT||As before: Maple Mono NF CN everywhere, dot font only in DOT-MATRIX widgets"
  "nothing|dotmatrix|Geist|DotMatrix Mono||Like Nothing OS: dots only for clocks, numbers and big titles; Geist text, DotMatrix Mono code with ligatures"
  "dot|dotmatrix|Geist|DotMatrix Mono||Dot layer: DotMatrix Dot in every big short text (bar, titles, launcher, lock, OSD, page headings)"
  "pixel|dotmatrix|Geist|DotMatrix Pixel||Dot layer plus pixel terminal and code (DotMatrix Pixel, ligatures)"
  "dot-accents|dotmatrix|Geist|DotMatrix Pixel||Dot accents: Pixel plus DotMatrix Dot in site headings and controls, bold terminal text and shell labels"
  "dots-all|dotmatrix|DotMatrix LED|DotMatrix LED|DotMatrix LED|Dots everywhere: every character in DotMatrix LED — interface, sites, titles, terminal and code"
  "dots-all-test-a|dotmatrix|DotMatrix Board A Sans|DotMatrix Board A Mono|DotMatrix Board A Sans|Test A: dots everywhere in DotMatrix Board (5×7 LED grid), round dots 65% — most separate, dimmer; terminals 15 pt, VS Code 20 px"
  "dots-all-test-b|dotmatrix|DotMatrix Board B Sans|DotMatrix Board B Mono|DotMatrix Board B Sans|Test B: dots everywhere in DotMatrix Board (5×7 LED grid), round dots 72% — balanced; terminals 15 pt, VS Code 20 px"
  "dots-all-test-c|dotmatrix|DotMatrix Board C Sans|DotMatrix Board C Mono|DotMatrix Board C Sans|Test C: dots everywhere in DotMatrix Board (5×7 LED grid), round dots 80% — brighter; terminals 15 pt, VS Code 20 px"
  "dots-all-test-d|dotmatrix|DotMatrix Board D Sans|DotMatrix Board D Mono|DotMatrix Board D Sans|Test D: dots everywhere in DotMatrix Board (5×7 LED grid), square LCD dots 65%; terminals 15 pt, VS Code 20 px"
  "dots-all-test-e|dotmatrix|DotMatrix Board E Sans|DotMatrix Board E Mono|DotMatrix Board E Sans|Test E: dots everywhere in DotMatrix Board (5×7 LED grid), square LCD dots 72%; terminals 15 pt, VS Code 20 px"
  "dots-all-test-f|dotmatrix|DotMatrix Board F Sans|DotMatrix Board F Mono|DotMatrix Board F Sans|Test F: dots everywhere in DotMatrix Board (5×7 LED grid), square LCD dots 80% — brightest; terminals 15 pt, VS Code 20 px"
  "dots-all-lumen|dotmatrix|DotMatrix Lumen Sans|DotMatrix Lumen Mono|DotMatrix Dot|Lumen: the tuned dots everywhere — 5×7 round dots with airy interface spacing, dotted code ligatures, DotMatrix Dot titles; grid sizes"
  "lumen|dotmatrix|DotMatrix Lumen Sans|DotMatrix Lumen Mono|DotMatrix Dot|Lumen family: 5×7 dots for all small text (Lumen Sans interface, Lumen Mono code and labels), DotMatrix Dot only in big text — clocks, OSD, page h1–h2"
  "nothing-os-test|dotmatrix|NType 82|Lettera Mono LL|Ndot 57|Test: Nothing OS fonts — NType 82 interface, Lettera Mono LL code, Ndot 57 titles (local fonts, no Cyrillic: falls back to Geist)"
  "ndot-test|dotmatrix|Ndot 57|DotMatrix Board B Mono|Ndot57Caps|Test: Ndot 57 interface, Ndot 57 Caps titles, DotMatrix Board B Mono terminal (local fonts, Cyrillic from DotMatrix Board B Sans)"
  "paper-shell|paper|$STOCK_FONT|$STOCK_FONT|Caveat|System as stock; handwritten Caveat only in the shell (bar, panels)"
  "paper-ui|paper|Pangolin|Monaspace Radon Var|Caveat|Readable handwritten Pangolin for the interface, Caveat for titles, handwritten monospaced Monaspace Radon for the terminal and code"
  "paper-hand|paper|Caveat|Monaspace Radon Var|Caveat|Handwritten Caveat everywhere; the terminal and code in handwritten monospaced Monaspace Radon"
  "paper-all|paper|Caveat|Caveat|Caveat|Absolutely everything in Caveat, terminal and code included (not monospaced)"
  "retro|retro|Pixelify Sans|DotMatrix Pixel|Pixelify Sans|Pixel interface (Pixelify Sans), pixel terminal and code (DotMatrix Pixel)"
)

# Запасной шрифт sans-serif для знаков, которых нет в шрифте профиля (кириллица у Ndot / NType).
declare -A FALLBACK_SANS=(["nothing-os-test"]="Geist" ["ndot-test"]="DotMatrix Board B Sans")

notify() { notify-send -t 4000 "Fonts" "$1" 2>/dev/null || echo "$1" >&2; }
spec() {
  local p
  for p in "${PROFILES[@]}"; do [[ ${p%%|*} == "$1" ]] && { echo "$p"; return 0; }; done
  return 1
}
current() { jq -r '.profile // "stock"' "$CFG" 2>/dev/null || echo stock; }
# Терминалы и fontconfig «как stock», если профиль оставляет шрифт Maple (stock, paper-shell, …).
stock_like() { [[ $1 == "$STOCK_FONT" ]]; }
# Без `grep -q` в конвейере: он выходит на первом совпадении, fc-list ловит SIGPIPE, и pipefail
# считает шрифт отсутствующим.
has_font() { fc-list : family | tr ',' '\n' | grep -xF -- "$1" >/dev/null; }

# Официальный релиз Geist распаковывается один раз в кэш: из него берутся Geist и исходник DotMatrix Mono.
geist_release() {
  local dir="$CACHE/geist-v1.9.0"
  if [[ ! -d $dir/geist-font ]]; then
    local tmp
    mkdir -p "$CACHE"
    tmp=$(mktemp -d -p "$CACHE")
    python3 -I -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' "$GEIST_ZIP" "$tmp/geist.zip"
    python3 -I -m zipfile -e "$tmp/geist.zip" "$tmp/x" >/dev/null
    mv "$tmp/x" "$dir"
  fi
  echo "$dir/geist-font"
}

install_geist() {
  has_font Geist && return 0
  local src
  src=$(geist_release)
  mkdir -p "$GEIST_DIR"
  cp "$src/Geist/variable/"*.ttf "$src/OFL.txt" "$GEIST_DIR/"
  fc-cache -f "$GEIST_DIR" >/dev/null
}

# DotMatrix LED — каждый знак DotMatrix Pixel точками (сетка 8×16); недостающие в Terminus знаки — из DejaVu Sans Mono.
DEJAVU=/usr/share/fonts/TTF/DejaVuSansMono
build_dots() {
  command -v uv >/dev/null || return 1
  [[ -f $BUILD_DIR/DotMatrixPixel-Regular.ttf ]] || return 1
  uv run -q --with fonttools --with freetype-py python3 -I "$FONT_SCRIPTS/dotmatrix-dots.py" \
    "$BUILD_DIR" "$BUILD_DIR" "$DEJAVU.ttf" "$DEJAVU-Bold.ttf" >/dev/null &&
    fc-cache -f "$BUILD_DIR" >/dev/null
}

# DotMatrix Board — из релиза Matrix Sans (вариант Screen: каждая точка — отдельный контур на сетке 5×7).
MATRIX_ZIP="https://github.com/FriedOrange/MatrixSans/releases/download/v1.800/MatrixSans-v1.800.zip"
matrix_release() {
  local dir="$CACHE/matrixsans-v1.800"
  if [[ ! -d $dir/MatrixSans-v1.800 ]]; then
    local tmp
    mkdir -p "$CACHE"
    tmp=$(mktemp -d -p "$CACHE")
    python3 -I -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' "$MATRIX_ZIP" "$tmp/m.zip"
    python3 -I -m zipfile -e "$tmp/m.zip" "$tmp/x" >/dev/null
    mv "$tmp/x" "$dir"
  fi
  echo "$dir/MatrixSans-v1.800"
}
# Варианты точки для проб dots-all-test-{a…f}: буква|форма|диаметр в долях шага → семейство «DotMatrix Board <БУКВА>».
BOARD_VARIANTS=("a|round|0.65" "b|round|0.72" "c|round|0.80" "d|square|0.65" "e|square|0.72" "f|square|0.80")
build_board() {
  command -v uv >/dev/null || return 1
  local src v key shape dot fail=0
  src=$(matrix_release) || return 1
  mkdir -p "$BUILD_DIR"
  local pids=()
  for v in "${BOARD_VARIANTS[@]}"; do
    IFS='|' read -r key shape dot <<<"$v"
    uv run -q --with fonttools --with freetype-py python3 -I "$FONT_SCRIPTS/dotmatrix-board.py" \
      "$src/fonts/ttf" "$BUILD_DIR" "$DEJAVU.ttf" "$DEJAVU-Bold.ttf" \
      --family "DotMatrix Board ${key^^}" --shape "$shape" --dot "$dot" >/dev/null &
    pids+=($!)
  done
  # DotMatrix Lumen (dots-all-lumen): точка 74 %, разрядка Sans в полточки, лигатуры Mono.
  uv run -q --with fonttools --with freetype-py python3 -I "$FONT_SCRIPTS/dotmatrix-board.py" \
    "$src/fonts/ttf" "$BUILD_DIR" "$DEJAVU.ttf" "$DEJAVU-Bold.ttf" \
    --family "DotMatrix Lumen" --shape round --dot 0.74 --track 50 --ligatures >/dev/null &
  pids+=($!)
  for v in "${pids[@]}"; do wait "$v" || fail=1; done
  ((fail == 0)) &&
    cp "$src/OFL.txt" "$BUILD_DIR/OFL-MatrixSans.txt" &&
    cp "$src/FONTLOG.txt" "$BUILD_DIR/FONTLOG-MatrixSans.txt" &&
    fc-cache -f "$BUILD_DIR" >/dev/null
}

# DotMatrix Mono, DotMatrix Pixel, DotMatrix LED и DotMatrix Board — из официальных шрифтов (fonttools через uv).
build_fonts() {
  command -v uv >/dev/null || { notify "uv is needed to build DOT-MATRIX fonts"; return 1; }
  mkdir -p "$BUILD_DIR"
  uv run -q --with fonttools python3 -I "$FONT_SCRIPTS/dotmatrix-mono.py" "$(geist_release)/GeistMono/ttf" "$BUILD_DIR" >/dev/null
  if [[ -f $TERMINESS-Regular.ttf ]]; then
    uv run -q --with fonttools python3 -I "$FONT_SCRIPTS/dotmatrix-pixel.py" \
      "$TERMINESS-Regular.ttf" "$TERMINESS-Bold.ttf" "$BUILD_DIR" >/dev/null
  fi
  cp "$FONT_SCRIPTS/../fonts/OFL.txt" "$BUILD_DIR/"
  fc-cache -f "$BUILD_DIR" >/dev/null
  build_dots || true
  build_board || true
}

# Профили, которым нужны размеры по сетке 5×7.
grid_profile() { [[ $1 == dots-all-test* || $1 == dots-all-lumen || $1 == lumen ]]; }
# Размеры по сетке DotMatrix Board (dots-all-test-*, Lumen): точки ровные, только когда их шаг (10 % кегля) — целое число
# пикселей экрана; 15 pt при масштабе 2 = 40 px, шаг 4 px. grid — запомнить текущие размеры (один раз) и поставить свои; restore — вернуть запомненные.
SIZES="$HOME/.local/state/omarchy/font-profile/sizes.json"
term_sizes() {
  python3 -I - "$1" "$SIZES" "$HOME/.config/kitty/kitty.conf" "$HOME/.config/ghostty/config" "$VSCODE" <<'PY'
import json, os, re, sys
mode, state, kitty, ghostty, vscode = sys.argv[1:]
GRID = {"kitty": "15.0", "ghostty": "15", "editor.fontSize": "20", "terminal.integrated.fontSize": "20"}
# (файл, ключ, регулярка значения): kitty «font_size 14.0», ghostty «font-size = 12», VS Code «"editor.fontSize": 16»
spots = [(kitty, "kitty", r"^(\s*font_size\s+)(\S+)"), (ghostty, "ghostty", r"^(font-size\s*=\s*)(\S+)"),
         (vscode, "editor.fontSize", r'("editor\.fontSize":\s*)([0-9.]+)'),
         (vscode, "terminal.integrated.fontSize", r'("terminal\.integrated\.fontSize":\s*)([0-9.]+)')]
def current():
    out = {}
    for path, key, rx in spots:
        if os.path.isfile(path):
            m = re.search(rx, open(path).read(), re.M)
            if m: out[key] = m.group(2)
    return out
def write(values):
    for path, key, rx in spots:
        if key in values and os.path.isfile(path):
            real = os.path.realpath(path)
            text = open(real).read()
            new = re.sub(rx, lambda m: m.group(1) + values[key], text, count=1, flags=re.M)
            if new != text: open(real, "w").write(new)
if mode == "grid":
    if not os.path.exists(state):
        os.makedirs(os.path.dirname(state), exist_ok=True)
        json.dump(current(), open(state, "w"))
    write(GRID)
elif os.path.exists(state):
    write(json.load(open(state)))
    os.remove(state)
PY
}

# Первая гарнитура в списке VS Code; остальной запасной список не трогаем.
vscode_font() {
  [[ -f $VSCODE ]] || return 0
  python3 -I - "$VSCODE" "$1" <<'PY'
import re, sys
path, font = sys.argv[1], sys.argv[2]
text = open(path).read()
for key in ("editor.fontFamily", "terminal.integrated.fontFamily", "debug.console.fontFamily",
            "markdown.preview.fontFamily"):
    text = re.sub(r'("%s":\s*")([^",]*)' % re.escape(key), lambda m: m.group(1) + font, text, count=1)
open(path, "w").write(text)
PY
}

# То же, что omarchy-font-set (терминалы + fontconfig monospace), но без перезапуска оболочки:
# Commons/Style.qml сам перечитывает fonts.conf, а перезапуск закрыл бы открытый Customizer.
set_mono() {
  local font=$1 esc
  esc=$(printf '%s' "$font" | sed 's/[\\&/]/\\&/g')
  [[ -f ~/.config/alacritty/alacritty.toml ]] &&
    sed --follow-symlinks -i "s/family = \".*\"/family = \"$esc\"/g" ~/.config/alacritty/alacritty.toml
  if [[ -f ~/.config/kitty/kitty.conf ]]; then
    if grep -qE '^[[:space:]]*font_family[[:space:]]+' ~/.config/kitty/kitty.conf; then
      # Заменяется только значение — отступ и выравнивание строки остаются.
      sed --follow-symlinks -i -E "s/^([[:space:]]*font_family[[:space:]]+).*/\\1$esc/" ~/.config/kitty/kitty.conf
    else
      printf '\nfont_family %s\n' "$font" >>~/.config/kitty/kitty.conf
    fi
    pkill -USR1 kitty || true
  fi
  if [[ -f ~/.config/ghostty/config ]]; then
    # Только незакомментированная строка, с кавычками или без.
    sed --follow-symlinks -i -E "s/^font-family[[:space:]]*=.*/font-family = $esc/" ~/.config/ghostty/config
    pkill -SIGUSR2 ghostty || true
  fi
  [[ -f ~/.config/foot/foot.ini ]] && sed --follow-symlinks -i "s/^font=[^:]*/font=$esc/" ~/.config/foot/foot.ini
  mkdir -p ~/.config/fontconfig
  cat >~/.config/fontconfig/fonts.conf <<XML
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any">
      <string>monospace</string>
    </test>
    <edit name="family" mode="prepend_first" binding="strong">
      <string>$font</string>
    </edit>
  </match>
</fontconfig>
XML
}

# kitty: bold/italic/bold_italic_font привязаны к Maple. Для профиля — auto (варианты берутся из font_family);
# исходные строки запоминаются при первом уходе со stock и возвращаются при stock.
KITTY_VARIANTS="$HOME/.local/state/omarchy/font-profile/kitty-variants.conf"
kitty_variants() {
  local kitty="$HOME/.config/kitty/kitty.conf"
  [[ -f $kitty ]] || return 0
  python3 -I - "$kitty" "$KITTY_VARIANTS" "$1" <<'PY'
import os, re, sys
kitty, backup, profile = sys.argv[1:]
keys = ("bold_font", "italic_font", "bold_italic_font")
path = os.path.realpath(kitty)
lines = open(path).read().split("\n")
rx = re.compile(r"^(%s)\s" % "|".join(keys))
if profile == "stock":
    if not os.path.exists(backup):
        sys.exit(0)
    saved = {l.split()[0]: l for l in open(backup).read().splitlines() if l.strip()}
    lines = [saved.get(l.split()[0], l) if rx.match(l) else l for l in lines]
else:
    if not os.path.exists(backup):
        os.makedirs(os.path.dirname(backup), exist_ok=True)
        open(backup, "w").write("\n".join(l for l in lines if rx.match(l)) + "\n")
    # dot-accents — жирное точками (DotMatrix Dot Black: обычной толщины точки бледные), курсив — как у шрифта.
    dot = {"bold_font": "DotMatrix Dot Black", "bold_italic_font": "DotMatrix Dot Black"} if profile == "accents" else {}
    lines = [f"{l.split()[0]:<20} {dot.get(l.split()[0], 'auto')}" if rx.match(l) else l for l in lines]
open(path, "w").write("\n".join(lines))
PY
}

# ghostty: строки font-feature заданы под Maple (ss01–ss04 — её лигатуры) и выключают calt. Своим шрифтам
# нужен calt (лигатуры DotMatrix Mono / DotMatrix Pixel), а наборы Maple поменяли бы форму букв Geist. Строки
# сводятся в блок между метками; исходные запоминаются при первом уходе со stock и возвращаются при stock.
GHOSTTY_FEATURES="$HOME/.local/state/omarchy/font-profile/ghostty-features.conf"
ghostty_features() {
  local conf="$HOME/.config/ghostty/config"
  [[ -f $conf ]] || return 0
  python3 -I - "$conf" "$GHOSTTY_FEATURES" "$1" <<'PY'
import os, sys
conf, backup, profile = sys.argv[1:]
path = os.path.realpath(conf)
lines = open(path).read().split("\n")
BEGIN, END = "# >>> omarchy-font-profile: font-feature", "# <<< omarchy-font-profile"
if BEGIN in lines:
    at, end = lines.index(BEGIN), lines.index(END)
    current = lines[at + 1:end]
    del lines[at:end + 1]
else:
    keep, current, at = [], [], None
    for i, line in enumerate(lines):
        nxt = lines[i + 1] if i + 1 < len(lines) else ""
        # font-feature и комментарий прямо над ней (кроме закомментированных настроек «# font-…»)
        if line.startswith("font-feature") or (line.startswith("#") and nxt.startswith("font-feature")
                                               and not line.startswith("# font-")):
            at = len(keep) if at is None else at
            current.append(line)
        else:
            keep.append(line)
    lines, at = keep, len(keep) if at is None else at
if profile == "stock":
    block = open(backup).read().splitlines() if os.path.exists(backup) else current
else:
    if not os.path.exists(backup) and "font-feature = calt" not in current:
        os.makedirs(os.path.dirname(backup), exist_ok=True)
        open(backup, "w").write("\n".join(current) + "\n")
    block = ["# лигатуры шрифтов DOT-MATRIX", "font-feature = calt"]
    if profile == "accents":  # dot-accents: жирное точками, как в kitty
        block += ["font-family-bold = DotMatrix Dot", "font-style-bold = Black",
                  "font-family-bold-italic = DotMatrix Dot", "font-style-bold-italic = Black"]
lines[at:at] = [BEGIN] + block + [END]
open(path, "w").write("\n".join(lines))
PY
}

fontconfig_sans() {
  if stock_like "$2"; then
    # Пустой файл fontconfig считает ошибкой XML — оставляем корректный пустой конфиг.
    [[ -f $FC_FILE ]] && printf '<?xml version="1.0"?>\n<!DOCTYPE fontconfig SYSTEM "fonts.dtd">\n<fontconfig/>\n' >"$FC_FILE"
    return 0
  fi
  mkdir -p "$FC_DIR"
  cat >"$FC_FILE" <<XML
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!-- omarchy-font-profile: sans-serif по профилю шрифтов (~/.config/omarchy/fonts.json). -->
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any"><string>sans-serif</string></test>
    <edit name="family" mode="prepend_first" binding="strong"><string>$2</string>${FALLBACK_SANS[$1]:+<string>${FALLBACK_SANS[$1]}</string>}</edit>
  </match>
</fontconfig>
XML
}

apply() {
  local profile=$1 line sans mono title
  line=$(spec "$profile") || { notify "Unknown font profile: $profile"; exit 2; }
  IFS='|' read -r _ _ sans mono title _ <<<"$line"

  [[ $sans == Geist || ${FALLBACK_SANS[$profile]:-} == Geist ]] && { install_geist || { notify "Could not download Geist"; exit 1; }; }
  if [[ $mono == "DotMatrix Board "* || $mono == "DotMatrix Lumen "* ]] && ! { has_font "$mono" && has_font "$sans"; }; then
    notify "Building DotMatrix Board…"
    build_board || { notify "Could not build DotMatrix Board"; exit 1; }
  fi
  if [[ $mono == "DotMatrix LED" ]] && ! has_font "$mono"; then
    notify "Building $mono…"
    { has_font "DotMatrix Pixel" || build_fonts; } && build_dots || { notify "Could not build $mono"; exit 1; }
  fi
  if [[ $mono == DotMatrix* ]] && ! has_font "$mono"; then
    notify "Building $mono…"
    build_fonts || { notify "Could not build $mono"; exit 1; }
  fi
  local missing=()
  has_font "$sans" || missing+=("$sans")
  has_font "$mono" || missing+=("$mono")
  [[ -z $title ]] || has_font "$title" || missing+=("$title")
  if ((${#missing[@]})); then
    notify "Missing fonts: ${missing[*]}. Install: sudo pacman -S ttf-terminus-nerd ttf-nerd-fonts-symbols, then omarchy-font-profile build-fonts"
    exit 1
  fi

  mkdir -p "$(dirname "$CFG")"
  jq -n --arg p "$profile" --arg s "$sans" --arg m "$mono" --arg t "$title" \
    '{profile: $p, sans: $s, mono: $m} + (if $t != "" then {title: $t} else {} end)' >"$CFG.tmp"
  mv "$CFG.tmp" "$CFG"

  fontconfig_sans "$profile" "$sans"
  # Caveat мельче обычных гротесков при том же кегле — интерфейсу на 2 пункта больше.
  local size=11
  grid_profile "$profile" && size=11.25  # 11.25 pt при масштабе 2 = 30 px: шаг точки Board ровно 3 px
  [[ $sans == Caveat ]] && size=13
  gsettings set org.gnome.desktop.interface font-name "$sans $size" 2>/dev/null || true
  gsettings set org.gnome.desktop.interface monospace-font-name "$mono 11" 2>/dev/null || true
  vscode_font "$mono"
  # Dark Reader, Stylus и шрифты страниц Helium и Firefox читают fonts.json; пишутся, когда браузер закрыт
  # (если открыт — уведомление «Перезапустить»).
  "$THEMES/omarchy-darkreader" sync >/dev/null 2>&1 || true
  "$THEMES/omarchy-stylus" sync >/dev/null 2>&1 || true
  "$THEMES/omarchy-surfingkeys" sync >/dev/null 2>&1 || true
  "$THEMES/omarchy-firefox-chrome" >/dev/null 2>&1 || true
  # Варианты kitty и лигатуры ghostty заданы под Maple: у профилей с моно Maple — как в stock.
  local term=custom
  stock_like "$mono" && term=stock
  [[ $profile == dot-accents ]] && term=accents
  kitty_variants "$term"
  ghostty_features "$term"
  if grid_profile "$profile"; then term_sizes grid; else term_sizes restore; fi
  set_mono "$mono"
  # Qt (qt6ct), Ghidra, Vesktop берут шрифты из fontconfig — после set_mono
  "$THEMES/omarchy-app-themes" >/dev/null 2>&1 || true
  notify "Font profile: $profile"
}

case "${1:-}" in
"") current ;;
list)
  # name, описание, стиль, sans, mono, title — первые два столбца как раньше (Customizer).
  for p in "${PROFILES[@]}"; do
    IFS='|' read -r n g sa mo ti d <<<"$p"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$n" "$d" "$g" "$sa" "$mo" "${ti:-$sa}"
  done
  ;;
apply) apply "$(current)" ;;
build-fonts) build_fonts && notify "DotMatrix Mono / DotMatrix Pixel built" ;;
-h | --help) sed -n '2,51p' "$0" ;;
*) apply "$1" ;;
esac
