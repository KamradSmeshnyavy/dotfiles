#!/usr/bin/env bash
# Сетка приложений по райсу (Super+Alt+Space, вместо стокового `omarchy-shell omarchy.dock apps`):
# у райса surface (~/.config/omarchy/style.json → "rice") — широкий лаунчер «Programs» (скин surface-wide
# kamradsmeshnyavy.menu, вкладки Apps / Shaders), у cozytile — список приложений его лаунчером, у остальных — список
# приложений выбранным скином лаунчера, а при стоковом скине list — стоковая сетка дока Omarchy.
set -euo pipefail

rice=$(jq -r '.rice // .id // ""' "$HOME/.config/omarchy/style.json" 2>/dev/null || true)
case $rice in
  surface) exec omarchy-shell shell summon omarchy.menu '{"menu":"apps","browse":true,"skin":"surface-wide"}' ;;
  # Cozytile: его rofi-лаунчер (drun) — сразу список приложений скином cozytile
  cozytile) exec omarchy-shell shell summon omarchy.menu '{"menu":"apps","browse":true,"skin":"cozytile"}' ;;
  # Unit-3: его меню NieR — сразу список приложений скином unit3
  unit3) exec omarchy-shell shell summon omarchy.menu '{"menu":"apps","browse":true,"skin":"unit3"}' ;;
  # Space: его «маленький терминал» под баром — сразу список приложений скином space
  space) exec omarchy-shell shell summon omarchy.menu '{"menu":"apps","browse":true,"skin":"space"}' ;;
esac
# Остальные: если у лаунчера выбран свой скин (не стоковая карточка list) — список приложений этим же скином,
# а не стоковая сетка дока другого вида
skin=$(jq -r '.skin // ""' "$HOME/.config/omarchy/extensions/menu-skin.json" 2>/dev/null || true)
if [[ -n $skin && $skin != list && $skin != null ]]; then
  exec omarchy-shell shell summon omarchy.menu '{"menu":"apps","browse":true}'
fi
exec omarchy-shell omarchy.dock apps
